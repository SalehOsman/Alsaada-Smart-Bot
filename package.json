{
  "name": "alsaada-smart-bot",
  "version": "2.0.0-alpha.86",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "docker compose up -d postgres redis && docker compose stop bot && tsx watch --clear-screen=false --tsconfig tsconfig.dev.json apps/bot-server/src/index.ts",
    "dev:bot": "tsx watch --clear-screen=false --tsconfig tsconfig.dev.json apps/bot-server/src/index.ts",
    "docker:up": "docker compose up -d",
    "docker:bot": "docker compose build --no-cache bot && docker compose up -d bot",
    "docker:stop:bot": "docker compose stop bot",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && pnpm --filter @alsaada/admin-dashboard typecheck",
    "prepare": "git config core.hooksPath .githooks",
    "format": "prettier --write .",
    "preflight:fix": "prettier --write . && eslint --fix",
    "make:flow": "tsx tools/scaffold/scaffold-flow-v2.ts",
    "make:test": "tsx tools/scaffold/scaffold-test.ts",
    "make:incident": "tsx tools/scaffold/scaffold-incident.ts",
    "branch:incident": "tsx tools/scaffold/scaffold-branch.ts incident",
    "branch:feature": "tsx tools/scaffold/scaffold-branch.ts feature",
    "branch:plan": "tsx tools/scaffold/scaffold-branch.ts plan",
    "make:module": "tsx tools/scaffold/scaffold-module.ts",
    "make:dashboard-feature": "tsx tools/scaffold/scaffold-dashboard.ts",
    "topology:generate": "tsx tools/governance/generate-topology.ts",
    "shared-helpers:verify": "tsx tools/governance/verify-shared-helpers.ts",
    "lock": "tsx tools/scaffold/lock.ts",
    "lock:all": "tsx tools/governance/unified-lock-engine.ts --all",
    "lock:verify": "tsx tools/governance/unified-lock-engine.ts --verify-locked",
    "unlock": "tsx tools/scaffold/unlock.ts",
    "unlock:request": "tsx tools/scaffold/unlock.ts request",
    "unlock:confirm": "tsx tools/scaffold/unlock.ts confirm",
    "flow:check": "tsx tools/governance/verify-flow-fast.ts",
    "flow:finish": "tsx tools/scaffold/lock.ts",
    "flow:unlock": "tsx tools/scaffold/unlock.ts",
    "module:finish": "tsx tools/scaffold/lock.ts",
    "module:unlock": "tsx tools/scaffold/unlock.ts",
    "dashboard:finish": "tsx tools/scaffold/lock.ts",
    "dashboard:unlock": "tsx tools/scaffold/unlock.ts",
    "speed:lock": "tsx tools/scaffold/lock.ts infra:speed-engine",
    "speed:unlock": "tsx tools/scaffold/unlock.ts infra:speed-engine",
    "docker:lock": "tsx tools/scaffold/lock.ts infra:docker",
    "docker:finish": "tsx tools/scaffold/lock.ts infra:docker",
    "docker:unlock": "tsx tools/scaffold/unlock.ts infra:docker",
    "test:flow": "vitest run",
    "test:changed": "vitest related",
    "modules:verify": "tsx tools/modules/cli.ts validate",
    "modules:generate": "tsx tools/modules/cli.ts generate",
    "modules:db:compose": "tsx tools/modules/compose-database.ts",
    "modules:db:verify": "tsx tools/modules/validate-migrations.ts",
    "modules:db:deploy": "tsx tools/modules/deploy-migrations.ts",
    "modules:build": "tsx tools/modules/build-release.ts",
    "modules:release:verify": "tsx tools/modules/verify-release.ts",
    "modules:deploy": "tsx tools/modules/deploy-release.ts",
    "core:immutability:verify": "tsx tools/governance/verify-core-immutability.ts",
    "module-boundaries:verify": "tsx tools/governance/verify-module-boundaries.ts",
    "make:module-migration": "tsx tools/scaffold/scaffold-module-migration.ts",
    "test:modules:contracts": "vitest run packages/core-components/tests/module-v2-contract.spec.ts",
    "test:modules:catalog": "vitest run tools/modules/tests/catalog.spec.ts tools/modules/tests/catalog-determinism.spec.ts tools/modules/tests/catalog-boundaries.spec.ts",
    "test:modules:bot": "vitest run apps/bot-server/tests/catalog-bot-integration.spec.ts apps/bot-server/tests/catalog-session-routing.spec.ts",
    "test:modules:dashboard": "vitest run apps/admin-dashboard/tests/module-pages.spec.ts apps/admin-dashboard/tests/module-api-auth.spec.ts apps/admin-dashboard/tests/module-client-boundaries.spec.ts",
    "test:modules:data": "vitest run tools/modules/tests/database-composition.spec.ts tools/modules/tests/migration-upgrade.spec.ts tools/modules/tests/migration-concurrency.spec.ts",
    "test:modules:scaffold": "vitest run tools/scaffold/tests/module-v2-scaffold.spec.ts tools/scaffold/tests/flow-v2-scaffold.spec.ts tools/scaffold/tests/scaffold-write-scope.spec.ts",
    "test:modules:release": "vitest run tools/modules/tests/release-artifact.spec.ts",
    "test:modules:parity": "vitest run tools/modules/tests/existing-modules-parity.spec.ts",
    "test:modules:locks": "vitest run tools/governance/tests/core-immutability.spec.ts tools/governance/tests/module-boundaries.spec.ts",
    "test:modules:acceptance": "vitest run tools/modules/tests/module-onboarding.e2e.spec.ts",
    "test:pre-commit": "tsx tools/governance/pre-commit-test-guard.ts",
    "test:audit": "tsx scripts/assertion-audit.ts --check",
    "test:assertions": "tsx scripts/assertion-audit.ts --check",
    "test:sentinel": "tsx tools/governance/test-constitutional-sentinel.ts",
    "audit:saleh": "tsx tools/governance/saleh-audit-suite.ts",
    "audit:saleh:boost": "tsx tools/governance/saleh-audit-suite.ts --all --guards",
    "audit:guards": "tsx tools/governance/saleh-audit-suite.ts --guards",
    "test:saleh": "vitest run tools/governance/tests/saleh-audit-suite.spec.ts",
    "test:armor": "vitest run tools/governance/tests/unified-lock-engine-armor.spec.ts",
    "skills:verify": "tsx tools/governance/verify-skill-graph.ts",
    "system:provision": "tsx scripts/provision.ts",
    "db:purge:test": "pnpm --filter @alsaada/database db:purge:test",
    "lint": "pnpm typecheck",
    "arch:verify": "tsx tools/governance/verify-architecture.ts",
    "migration:verify": "tsx tools/governance/verify-migration-registry.ts",
    "flow-contracts:verify": "tsx tools/governance/verify-flow-contracts.ts",
    "telegram-contracts:verify": "tsx tools/governance/verify-telegram-contracts.ts",
    "ai-compliance:verify": "tsx tools/governance/verify-ai-compliance.ts",
    "dashboard-auth:verify": "tsx tools/governance/verify-dashboard-auth-contract.ts",
    "financial:verify": "tsx tools/governance/verify-financial-integrity.ts",
    "perf-budget:verify": "tsx tools/governance/verify-performance-budget.ts",
    "latency:verify": "tsx tools/governance/verify-latency-anti-patterns.ts",
    "rbac-matrix:verify": "tsx tools/governance/verify-rbac-matrix.ts",
    "field-masking:verify": "tsx tools/governance/verify-field-masking.ts",
    "observability:verify": "tsx tools/governance/verify-observability-contract.ts",
    "test-authenticity:verify": "tsx tools/governance/verify-test-authenticity.ts",
    "rbac-invariants:verify": "tsx tools/governance/verify-rbac-invariants.ts",
    "boundary-deserialization:verify": "tsx tools/governance/verify-boundary-deserialization.ts",
    "legacy-parity:verify": "tsx tools/governance/verify-legacy-parity.ts",
    "git-hygiene:verify": "tsx tools/governance/verify-git-hygiene.ts",
    "secrets:verify": "tsx tools/governance/verify-secret-leakage.ts",
    "sast:verify": "tsx tools/governance/verify-code-security.ts",
    "security:semgrep": "pnpm sast:verify",
    "release:bump": "tsx tools/release/release-engine.ts bump",
    "release:verify": "tsx tools/governance/verify-release-sync.ts",
    "version-packages": "changeset version && tsx tools/release/sync-root-version.ts",
    "release:tag": "changeset publish",
    "upgrade:wizard": "tsx tools/upgrade/wizard.ts",
    "upgrade:impact": "tsx tools/upgrade/impact-scanner.ts",
    "upgrade:rollback": "tsx tools/upgrade/rollback-manager.ts",
    "upgrade:verify": "tsx tools/upgrade/verify-upgrade.ts",
    "ci:simulate": "pnpm typecheck && pnpm test && pnpm git-hygiene:verify && pnpm governance:verify",
    "governance:verify": "pnpm arch:verify && pnpm migration:verify && pnpm flow-contracts:verify && pnpm telegram-contracts:verify && pnpm docs:audit && pnpm docs:parity && pnpm docs:verify && pnpm dashboard-auth:verify && pnpm financial:verify && pnpm perf-budget:verify && pnpm latency:verify && pnpm rbac-matrix:verify && pnpm field-masking:verify && pnpm observability:verify && pnpm test-authenticity:verify && pnpm rbac-invariants:verify && pnpm boundary-deserialization:verify && pnpm legacy-parity:verify && pnpm git-hygiene:verify && pnpm secrets:verify && pnpm sast:verify && pnpm release:verify && pnpm governance:tamper-check",
    "docs:audit": "tsx tools/governance/verify-docs-audit.ts",
    "docs:parity": "tsx tools/governance/verify-docs-parity.ts",
    "docs:sync": "tsx tools/docs/transform-pipeline.ts",
    "docs:check": "tsx tools/docs/transform-pipeline.ts --check",
    "docs:verify": "tsx tools/docs/verify-docs.ts",
    "docs:dev": "pnpm docs:sync && pnpm --filter @alsaada/docs dev",
    "docs:build": "pnpm docs:sync && pnpm --filter @alsaada/docs build",
    "build:docs-portal": "pnpm docs:sync && pnpm --filter @alsaada/docs build",
    "docs:preview": "pnpm --filter @alsaada/docs preview",
    "governance:lock": "tsx tools/governance/verify-governance-lock.ts --write",
    "governance:tamper-check": "tsx tools/governance/verify-governance-tamper.ts",
    "ssot:index": "tsx tools/governance/rag-engine.ts index",
    "ssot:query": "tsx tools/governance/rag-engine.ts query",
    "ssot:sync": "tsx tools/governance/rag-engine.ts index",
    "agent:check": "tsx tools/governance/agent-dispatcher.ts check",
    "agent:audit": "tsx tools/governance/agent-dispatcher.ts audit",
    "ocr:review": "ocr review --concurrency 2",
    "ocr:preview": "ocr review --preview",
    "ocr:viewer": "ocr viewer",
    "jev": "tsx tools/governance/jev-auditor.ts",
    "jev:diff": "tsx tools/governance/jev-auditor.ts --diff",
    "jev:flow": "tsx tools/governance/verify-flow-fast.ts",
    "jev:tests": "tsx tools/governance/jev-auditor.ts --tests",
    "jev:ux": "tsx tools/governance/jev-auditor.ts --ux",
    "jev:consult": "tsx tools/governance/jev-auditor.ts --consult",
    "test:jev": "vitest run tools/governance/tests/jev-auditor.spec.ts tools/governance/tests/jev-skill-consultant.spec.ts",
    "migration:sync": "tsx tools/governance/sync-migration-registry.ts",
    "incidents:summary": "tsx tools/governance/incident-summary.ts",
    "incident:verify": "tsx tools/governance/verify-incidents.ts",
    "test:incidents": "vitest run tools/governance/tests/verify-incidents.spec.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.13.6",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.9.3",
    "vitest": "^3.0.8"
  }
}
