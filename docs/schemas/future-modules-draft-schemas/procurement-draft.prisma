// =============================================================================
// Draft Prisma Schema for Future Module: Procurement, Suppliers & Invoices
// Archived per Work Plan 117 (Sovereign Modular Database Emancipation)
// When implementing this module, review, update and move to modules/procurement/database/
// =============================================================================

model Supplier {
  id              String   @id @default(uuid())
  code            String   @unique // e.g. #VND-XXX or #EX-VND-XXX
  name            String
  category        String // WORKSHOPS_MACHINING, SPARE_PARTS, FOOD_CATERING, FUEL_OILS, EQUIPMENT_RENTAL, GENERAL_SUPPLIES
  phoneEncrypted  String?
  phoneBlindIndex String?
  taxNumber       String?
  openingBalance  Decimal  @default(0) @db.Decimal(14, 2)
  totalInvoiced   Decimal  @default(0) @db.Decimal(14, 2)
  totalPaid       Decimal  @default(0) @db.Decimal(14, 2)
  currentBalance  Decimal  @default(0) @db.Decimal(14, 2)
  scope           String   @default("FIELD") // FIELD, EXECUTIVE
  siteId          String?  // Core Loose ID reference
  telegramId      BigInt?  @unique
  status          String   @default("ACTIVE") // ACTIVE, SUSPENDED
  version         Int      @default(1) // Optimistic locking
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  invoices SupplierInvoice[]
  payments SupplierPayment[]

  @@index([phoneBlindIndex])
  @@map("suppliers")
}

model SupplierInvoice {
  id               String   @id @default(uuid())
  invoiceNumber    String   @unique // e.g. #WO-YYYY-XXXX
  supplierId       String
  siteId           String   // Core Loose ID reference
  equipmentId      String?  // Equipment Loose ID reference
  invoiceDate      DateTime
  subtotalAmount   Decimal  @db.Decimal(14, 2)
  taxAmount        Decimal  @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal  @db.Decimal(14, 2)
  paidAmount       Decimal  @default(0) @db.Decimal(14, 2)
  remainingBalance Decimal  @db.Decimal(14, 2)
  paymentStatus    String   @default("UNPAID") // UNPAID, PARTIALLY_PAID, PAID_FULL
  description      String?
  invoicePhotoUri  String?
  sha256Checksum   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  supplier Supplier              @relation(fields: [supplierId], references: [id])
  items    SupplierInvoiceItem[]
  payments SupplierPayment[]

  @@index([supplierId, paymentStatus])
  @@index([siteId])
  @@map("supplier_invoices")
}

model SupplierInvoiceItem {
  id              String   @id @default(uuid())
  invoiceId       String
  itemSequence    Int
  itemDescription String
  quantity        Decimal  @db.Decimal(10, 2)
  unit            String   @default("UNIT")
  unitPrice       Decimal  @db.Decimal(12, 2)
  totalPrice      Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  invoice SupplierInvoice @relation(fields: [invoiceId], references: [id])

  @@map("supplier_invoice_items")
}

model SupplierPayment {
  id                      String   @id @default(uuid())
  paymentNumber           String   @unique // e.g. #SPAY-YYYY-XXXX
  supplierId              String
  invoiceId               String?
  amount                  Decimal  @db.Decimal(14, 2)
  paymentMethod           String   @default("CASH_CUSTODY") // CASH_CUSTODY, BANK_TRANSFER, CHEQUE, TREASURY_CASH
  disbursedFromTreasuryId String?  // Custody Loose ID reference
  disbursedFromCustodyId  String?  // Custody Loose ID reference
  transactionReference    String?
  receiptPhotoUri         String?
  sha256Checksum          String?
  recordHash              String   @default("") @map("record_hash")
  previousHash            String?  @map("previous_hash")
  hashTimestamp           DateTime @default(now()) @map("hash_timestamp")
  paymentDate             DateTime @default(now())
  createdAt               DateTime @default(now())

  supplier Supplier         @relation(fields: [supplierId], references: [id])
  invoice  SupplierInvoice? @relation(fields: [invoiceId], references: [id])

  @@index([supplierId])
  @@index([recordHash])
  @@index([previousHash])
  @@index([hashTimestamp])
  @@map("supplier_payments")
}
