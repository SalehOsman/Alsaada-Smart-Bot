# ==============================================================================
# Al-Saada Smart Bot Enterprise — Sovereign Air-Gapped Package Manager Config
# ==============================================================================
# Enforces local store preference and prevents redundant network roundtrips
# during development and AI agent execution (Work Plan 102).
# ==============================================================================

prefer-offline=true
verify-deps-before-run=false
package-import-method=auto
min-release-age=7
fetch-retries=2
fetch-retry-maxtimeout=10000
network-concurrency=8
