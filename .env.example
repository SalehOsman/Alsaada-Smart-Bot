# ==============================================================================
# Al-Saada Smart Bot Enterprise Environment Variables Template
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=3000

# Telegram Bot Credentials
BOT_TOKEN=your_telegram_bot_token_here
SUPER_ADMIN_TELEGRAM_ID=your_telegram_numeric_id_here

# PostgreSQL Database Configuration
DB_NAME=alsaada_db
DB_USER=alsaada_admin
DB_PASSWORD=change_this_to_a_strong_password_in_production
DB_PORT=5432
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}?schema=public

# Application-Level Security & Field Encryption (ALE)
# Generate a 32-byte hex key: openssl rand -hex 32
DATABASE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Generate a 16-byte hex salt for HMAC blind indexing
BLIND_INDEX_SALT=abcdef0123456789abcdef0123456789

# Google Sheets Service Account (For Hybrid Outbox Sync)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
