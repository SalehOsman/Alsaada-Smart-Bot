# ==============================================================================
# Al-Saada Smart Bot Enterprise Environment Variables Template
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=3000
HOST_PORT=3001

# Telegram Bot Credentials
BOT_TOKEN=your_telegram_bot_token_here
SUPER_ADMIN_TELEGRAM_ID=your_telegram_numeric_id_here

# PostgreSQL Database Configuration
DB_NAME=alsaada_db
DB_USER=alsaada_admin
DB_PASSWORD=change_this_to_a_strong_password_in_production
DB_PORT=5432
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}?schema=public

# Redis Cache Configuration (Enterprise Cache & Rate Limiting)
REDIS_PASSWORD=change_this_to_a_secure_redis_password_2026
REDIS_PORT=6380
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# Application-Level Security & Field Encryption (ALE)
# Generate a 32-byte hex key: openssl rand -hex 32
DATABASE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Generate a 16-byte hex salt for HMAC blind indexing
BLIND_INDEX_SALT=abcdef0123456789abcdef0123456789

# AI / Vision Engine (Gemini API)
GEMINI_API_KEY=your_gemini_api_keys_comma_separated

# Google Sheets Service Account (For Hybrid Outbox Sync)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Sovereign Dashboard Origin Configuration
# DASHBOARD_LOCAL_URL strictly accepts http://localtest.me:<port> (RFC compliant loopback domain)
DASHBOARD_LOCAL_URL=http://localtest.me:3002
# DASHBOARD_TUNNEL_URL strictly accepts HTTPS public tunnel or domain (without trailing slash)
DASHBOARD_TUNNEL_URL=https://your-tunnel.example
