model WorkerBalanceSnapshot {
  id                      String   @id @default(uuid())
  workerId                String   @unique
  totalEarnedAllTime      Decimal  @default(0) @db.Decimal(14, 2)
  totalPaidAllTime        Decimal  @default(0) @db.Decimal(14, 2)
  currentMonthAdvances    Decimal  @default(0) @db.Decimal(12, 2)
  outstandingLoansBalance Decimal  @default(0) @db.Decimal(12, 2)
  lastUpdatedLedgerHash   String?
  updatedAt               DateTime @updatedAt

  worker Worker @relation(fields: [workerId], references: [id])

  @@map("worker_balance_snapshots")
}

model WorkerCommitmentScore {
  id                    String   @id @default(uuid())
  scoreNumber           String   @unique // e.g. #WCS-YYYYMM-XXXX
  workerId              String
  siteId                String?
  evaluationDate        DateTime @default(now())
  periodStart           DateTime
  periodEnd             DateTime
  totalScore            Int      @default(100) // 0 - 100
  tier                  String   @default("COMMITTED") // COMMITTED (80-100), MODERATE (60-79), UNDER_REVIEW (<60), PROBATION (new hire)
  contractTypeEvaluated String   @default("PERMANENT") // PERMANENT, DAILY_LABOR, SEASONAL
  leaveShiftScore       Decimal  @default(40) @db.Decimal(5, 2) // max 40
  disciplinaryScore     Decimal  @default(30) @db.Decimal(5, 2) // max 30
  ppeScore              Decimal  @default(15) @db.Decimal(5, 2) // max 15
  financialScore        Decimal  @default(15) @db.Decimal(5, 2) // max 15
  breakdown             Json? // Detailed statistics (leaves, penalties, bonuses, PPE loss, advance compliance)
  recoveryGuidance      String? // Actionable advice for improving the score
  sha256Checksum        String? // Cryptographic forensic audit hash
  snapshotKey           String? // e.g. "2026-09" for monthly snapshot, null for live
  calculatedBy          String?  @default("SYSTEM") // SYSTEM or Admin TelegramId
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  worker Worker @relation(fields: [workerId], references: [id])
  site   Site?  @relation(fields: [siteId], references: [id])

  @@unique([workerId, snapshotKey])
  @@index([workerId, evaluationDate])
  @@index([siteId, tier])
  @@index([tier])
  @@index([evaluationDate])
  @@map("worker_commitment_scores")
}

model Leave {
  id                    String    @id @default(uuid())
  leaveNumber           String    @unique // e.g. #LV-YYYY-XXXX
  workerId              String
  siteId                String
  leaveType             String    @default("ANNUAL") // ANNUAL, CASUAL, MISSION, SICK, UNPAID
  requestDate           DateTime  @default(now())
  departureDate         DateTime
  expectedReturnDate    DateTime
  actualReturnDate      DateTime?
  status                String    @default("PENDING") // PENDING, APPROVED, REJECTED, ACTIVE_ON_LEAVE, RESUMED, OVERDUE
  overdueDays           Int       @default(0)
  penaltyDaysCalculated Decimal   @default(0) @db.Decimal(6, 2)
  deductionAmount       Decimal   @default(0) @db.Decimal(12, 2)
  isOverstayPardoned    Boolean   @default(false)
  overstayPardonReason  String?
  supervisorNotes       String?
  approvedByUserId      BigInt?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  worker     Worker           @relation(fields: [workerId], references: [id])
  site       Site             @relation(fields: [siteId], references: [id])
  allowances LeaveAllowance[]

  @@index([workerId, status])
  @@index([siteId, departureDate])
