  daysAbsent                    Decimal   @default(0) @db.Decimal(5, 2)
  daysOnLeave                   Decimal   @default(0) @db.Decimal(5, 2)
  baseDailyWage                 Decimal   @db.Decimal(12, 2)
  earnedBasicSalary             Decimal   @db.Decimal(12, 2)
  overtimeAmount                Decimal   @default(0) @db.Decimal(12, 2)
  bonusesAmount                 Decimal   @default(0) @db.Decimal(12, 2)
  customAllowancesAmount        Decimal   @default(0) @db.Decimal(12, 2)
  reimbursementsAmount          Decimal   @default(0) @db.Decimal(12, 2)
  grossEarnings                 Decimal   @db.Decimal(14, 2)
  cashAdvancesDeduction         Decimal   @default(0) @db.Decimal(12, 2)
  cigaretteWithdrawalsDeduction Decimal   @default(0) @db.Decimal(12, 2)
  purchaseWithdrawalsDeduction  Decimal   @default(0) @db.Decimal(12, 2)
  penaltiesDeduction            Decimal   @default(0) @db.Decimal(12, 2)
  loanInstallmentDeduction      Decimal   @default(0) @db.Decimal(12, 2)
  otherDeductions               Decimal   @default(0) @db.Decimal(12, 2)
  totalDeductions               Decimal   @db.Decimal(14, 2)
  netSalaryPayable              Decimal   @db.Decimal(14, 2)
  paymentStatus                 String    @default("PENDING") // PENDING, DISBURSED, HELD_DISPUTED
  payoutMethod                  String    @default("CASH_ENVELOPE") // CASH_ENVELOPE, VODAFONE_CASH, INSTAPAY, BANK_DEPOSIT
  payoutReference               String?
  disbursedAt                   DateTime?
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  payrollRun           PayrollRun           @relation(fields: [payrollRunId], references: [id])
  worker               Worker               @relation(fields: [workerId], references: [id])
  settledExpenseClaims WorkerExpenseClaim[]

  @@unique([payrollRunId, workerId])
  @@map("payroll_records")
}
