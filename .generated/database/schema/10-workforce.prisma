// ==============================================================================
// Workforce Domain Database Schema (Work Plan 112)
// Models owned by modules/workforce
// ==============================================================================

model Department {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. OP, FL, MNT, SEC, ADM
  name        String // e.g. إدارة التشغيل والمعدات
  order       Int      @default(99)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobs    JobTitle[]
  workers Worker[]

  @@map("departments")
}

model JobTitle {
  id                String   @id @default(uuid())
  departmentId      String
  code              String // e.g. DRV, HLP, TEC, OPR, ENG
  name              String // e.g. سائق لودر
  baseSalary        Decimal  @default(0) @db.Decimal(12, 2)
  additionalSalary  Decimal  @default(0) @db.Decimal(12, 2)
  baseWageGuideline Decimal? @db.Decimal(12, 2)
  workDays          Int      @default(20)
  restDays          Int      @default(10)
  totalCycleDays    Int      @default(30)
  shiftNature       String   @default("دورة قياسية (20+10)")
  minHeadcount      Int      @default(1)
  order             Int      @default(99)
  notes             String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  department      Department         @relation(fields: [departmentId], references: [id])
  workers         Worker[]
  salaryHistories JobSalaryHistory[]

  @@unique([departmentId, code])
  @@map("job_titles")
}

model JobSalaryHistory {
  id                       String   @id @default(uuid())
  jobTitleId               String
  previousBaseSalary       Decimal  @db.Decimal(12, 2)
  previousAdditionalSalary Decimal  @db.Decimal(12, 2)
  newBaseSalary            Decimal  @db.Decimal(12, 2)
  newAdditionalSalary      Decimal  @db.Decimal(12, 2)
  scope                    String // "NEW_HIRES_ONLY" | "ALL_ACTIVE_WORKERS"
  affectedWorkersCount     Int      @default(0)
  effectiveDate            DateTime
  changedByTelegramId      BigInt
  notes                    String?
  createdAt                DateTime @default(now())

  jobTitle JobTitle @relation(fields: [jobTitleId], references: [id])

  @@map("job_salary_histories")
}

model CycleTransitionHistory {
  id         String  @id @default(uuid())
  targetType String // "JOB_TITLE" | "SITE" | "WORKER"
  targetId   String // ID of JobTitle or Site or Worker
  targetCode String? // Code e.g. DRV, STE-01, OP-DRV-0042
  targetName String? // Name e.g. سائق لودر

  // Previous cycle
  previousWorkDays Int
  previousRestDays Int
  previousRatio    Decimal @db.Decimal(6, 4) // e.g. 0.5000

  // New cycle
  newWorkDays Int
  newRestDays Int
  newRatio    Decimal @db.Decimal(6, 4) // e.g. 0.2500

  // Transition policy & Effective date
  transitionPolicy String   @default("IMMEDIATE_PRORATED") // "IMMEDIATE_PRORATED" | "NEXT_CYCLE" | "NEW_HIRES_ONLY" | "CUSTOM_DATE"
  effectiveDate    DateTime @default(now())
  appliedByAdminId BigInt?
  notes            String?

  createdAt DateTime @default(now())

  @@index([targetType, targetId, effectiveDate])
  @@index([effectiveDate])
  @@map("cycle_transition_history")
}

model ShiftCycleTemplate {
  id             String   @id @default(uuid())
  name           String
  workDays       Int      @map("work_days")
  restDays       Int      @map("rest_days")
  totalCycleDays Int      @map("total_cycle_days")
  isStandard     Boolean  @default(true) @map("is_standard")
  isActive       Boolean  @default(true) @map("is_active")
  displayOrder   Int      @default(0) @map("display_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("shift_cycle_templates")
}

model Worker {
  id                      String    @id @default(uuid())
  code                    String    @unique // Active structured code (e.g. OP-DRV-0042)
  legacyCode              String? // Historical / legacy code (e.g. "106", "101")
  aliases                 String[] // Historical & legacy codes (e.g. ["106", "101", "OP-HLP-0015"])
  name                    String
  nickname                String?
  idType                  String    @default("NATIONAL_ID") // NATIONAL_ID, PASSPORT
  nationality             String    @default("مصر")
  nationalIdEncrypted     String?
  nationalIdBlindIndex    String?   @unique
  passportNumberEncrypted String?
  passportBlindIndex      String?   @unique
  birthDate               DateTime
  gender                  String // MALE, FEMALE
  governorateCode         String    @default("88")
  jobTitle                String
  departmentId            String?
  jobTitleId              String?
  siteId                  String?
  hireDate                DateTime  @default(now())
  contractType            String    @default("PERMANENT") // DAILY_LABOR, SEASONAL, PERMANENT
  shiftSystem             String    @default("24_WORK_6_REST")
  dailyWage               Decimal   @db.Decimal(12, 2)
  basicSalary             Decimal   @default(0) @db.Decimal(12, 2)
  additionalSalary        Decimal   @default(0) @db.Decimal(12, 2)
  fixedAllowances         Decimal   @default(0) @db.Decimal(12, 2)
  paymentMethod           String    @default("CASH_SITE") // CASH_SITE, VODAFONE_CASH, INSTAPAY, BANK_TRANSFER
  accountNumberEncrypted  String?
  walletType              String? // e.g. "محفظة فودافون كاش", "إنستاباي"
  canteenCigarettePolicy  String    @default("NONE") // ONE_PACK_DAILY, FULL_COVERAGE, NONE, CUSTOM
  cigaretteBrand          String? // نوع / صنف السجائر المعتمد للعامل
  canteenItemId           String? // معرف صنف السجائر من جدول مخزن الكانتين
  walletOwnerName         String? // اسم صاحب المحفظة
  instaPayHandle          String? // معرف إنستاباي
  insuranceNumber         String? // الرقم التأميني المكون من 8-10 أرقام
  insuranceStatus         String? // الموقف من التأمينات (مؤمن عليه حالياً، مؤمن سابقاً، غير مؤمن، متفرغ)
  ppeShoeSize             String? // مقاس حذاء السلامة السيفتي (41-46)
  ppeUniformSize          String? // مقاس الأفرول / الزي الميداني (M-4XL)
  medicalNotes            String? // الأمراض المزمنة، الحساسية، الملاحظات الطبية
  barracksUnit            String? // مقر السكن / رقم الكرفان أو العنبر بالموقع
  bedNumber               String? // رقم السرير المخصص
  phoneEncrypted          String?
  phoneBlindIndex         String?
  emergencyContactName    String?
  emergencyPhoneEncrypted String?
  drivingLicense          String? // لا توجد رخصة، خاصة، مهنية 1، 2، 3، معدات ثقيلة
  militaryStatus          String? // أدى الخدمة، إعفاء نهائي، إعفاء مؤقت، إلخ
  maritalStatus           String? // أعزب، متزوج، متزوج ويعول، إلخ
  previousInsuranceStatus String? // غير مؤمن، مؤمن سابقاً، متفرغ
  idCardFrontPath         String? // صورة وجه البطاقة / الجواز
  idCardBackPath          String? // صورة ظهر البطاقة
  idCardExpiryDate        DateTime? // تاريخ انتهاء سريان البطاقة (مستخرج بالذكاء الاصطناعي من ظهر البطاقة)
  idCardExpiryAlertSentAt DateTime? // تاريخ إرسال إشعار التنبيه قبل الانتهاء بشهر
  address                 String? // محل الإقامة / العنوان المستخرج بالذكاء الاصطناعي أو المسجل يدوياً
  telegramId              BigInt?   @unique
  status                  String    @default("ACTIVE") // ACTIVE, ON_LEAVE, TERMINATED, RESIGNED
  terminationDate         DateTime?
  terminationReason       String?
  isDeleted               Boolean   @default(false)
  deletedAt               DateTime?
  deletedBy               BigInt?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  department             Department?                   @relation(fields: [departmentId], references: [id])
  jobRef                 JobTitle?                     @relation(fields: [jobTitleId], references: [id])
  site                   Site?                         @relation(fields: [siteId], references: [id])
  canteenItem            CanteenItem?                  @relation("WorkerCigaretteItem", fields: [canteenItemId], references: [id])
  user                   User?
  salaryHistories        SalaryHistory[]
  changeLogs             WorkerChangeLog[]
  customAllowances       WorkerCustomAllowance[]
  ppeAssets              PPEAsset[]
  disciplinaryAndBonuses DisciplinaryAndBonus[]
  clearance              WorkerClearance?
  delegations            WorkerDelegation[]
  balanceSnapshot        WorkerBalanceSnapshot?
  leaves                 Leave[]
  leaveAllowances        LeaveAllowance[]
  dutyRosters            DutyRoster[]
  assignedTasks          SiteTask[]
  managedCustodies       FinancialCustody[]
  ledgers                FinancialLedger[]
  advanceRequests        AdvanceRequest[]
  advanceInstallments    AdvanceInstallment[]
  accommodations         SiteAccommodationAssignment[]
  payrollRecords         PayrollRecord[]
  mealSurveys            MealSurvey[]
  fuelLogs               FuelDispenseLog[]
  operatedEquipments     Equipment[]
  fuelTanksSupervised    FuelTank[]
  hospitalityDisbursed   HospitalityExpense[]
  kitchenDispenses       KitchenMealDispense[]
  foodShipmentsReceived  FoodInboundShipment[]
  expenseClaims          WorkerExpenseClaim[]
  editRequests           WorkerEditRequest[]
  documents              WorkerDocument[]
  commitmentScores       WorkerCommitmentScore[]

  @@index([phoneBlindIndex])
  @@index([status])
  @@index([isDeleted])
  @@index([legacyCode])
  @@index([idCardExpiryDate])
  @@index([siteId, status])
  @@index([jobTitleId])
  @@index([departmentId])
  @@map("workers")
}

model WorkerDocument {
  id            String   @id @default(uuid())
  workerId      String
  title         String // e.g. "عقد عمل", "شهادة صحية", "فيش وتشبيه", "مؤهل دراسي"
  category      String   @default("OTHER") // NATIONAL_ID, PASSPORT, WORK_PERMIT, CONTRACT, HEALTH_CERTIFICATE, CRIMINAL_RECORD, DRIVING_LICENSE, EDUCATION, OTHER
  fileName      String
  fileType      String // "image/jpeg", "application/pdf", etc.
  fileUri       String // المسار المحلي: attachments/workers/OP-DRV-001/filename.pdf
  driveFileId   String? // معرف الملف على Google Drive إن وُجد
  fileSizeBytes BigInt?
  uploadedBy    BigInt? // Telegram ID لمن قام برفع المستند
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@map("worker_documents")
}

