// =============================================================
// Sovereign Core Database Schema (Single Source of Truth)
// Packages: @alsaada/database
// Governed by Work Plan 117 (Sovereign Modular Database Emancipation)
// Contains strictly Core Shared Kernel models (Zero Ghost Models)
// =============================================================

datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
  output   = "../../packages/database/src/generated/client"
}

// -------------------------------------------------------------
// 1. Core Enterprise Entities (Company, Projects, Sites)
// -------------------------------------------------------------

model CompanyProfile {
  id                           String   @id @default(uuid())
  legalName                    String
  tradeName                    String
  taxRegistrationNumber        String?
  commercialRegistrationNumber String?
  headquartersAddress          String?
  primaryPhone                 String?
  officialEmail                String?
  baseCurrency                 String   @default("EGP")
  settings                     Json?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  @@map("company_profiles")
}

model Project {
  id              String    @id @default(uuid())
  code            String    @unique // e.g. PRJ-PHOS-01
  name            String
  clientName      String?
  startDate       DateTime?
  endDate         DateTime?
  estimatedBudget Decimal?  @db.Decimal(14, 2)
  status          String    @default("ACTIVE") // PLANNING, ACTIVE, SUSPENDED, COMPLETED
  description     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sites Site[]

  @@map("projects")
}

model Site {
  id                   String   @id @default(uuid())
  projectId            String
  code                 String   @unique // e.g. STE-KHA, STE-ASW
  name                 String
  governorateCode      String?
  latitude             Decimal? @db.Decimal(10, 7)
  longitude            Decimal? @db.Decimal(10, 7)
  geofenceRadiusMeters Int?     @default(1000)
  status               String   @default("ACTIVE") // ACTIVE, INACTIVE
  telegramGroupId      BigInt?
  telegramTopicId      Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  project           Project                 @relation(fields: [projectId], references: [id])
  users             User[]
  workers           Worker[]
  leaves            Leave[]
  advanceRequests   AdvanceRequest[]
  ppeAssets         PPEAsset[]
  commitmentScores  WorkerCommitmentScore[]
  workerDelegations WorkerDelegation[]

  @@map("sites")
}

// -------------------------------------------------------------
// 2. Financial Ledger & Cumulative Hash Chain
// -------------------------------------------------------------

model FinancialLedger {
  id                  String    @id @default(uuid())
  voucherNumber       String    @unique // e.g. #ADV-YYYY-XXXX, #PAY-YYYY-XXXX
  recordHash          String    @default("") @map("record_hash")
  previousHash        String?   @map("previous_hash")
  hashTimestamp       DateTime  @default(now()) @map("hash_timestamp")
  transactionType     String // ADVANCE_CASH, WITHDRAWAL_CIGARETTES, WITHDRAWAL_PURCHASES, SALARY_PAYOUT, SUPPLIER_PAYMENT, CUSTODY_DISBURSEMENT, CUSTODY_REFUND, GENERAL_EXPENSE
  amount              Decimal   @db.Decimal(14, 2)
  currency            String    @default("EGP")
  sourceAccount       String
  destinationAccount  String
  sourceCustodyId     String? // Loose ID reference
  workerId            String?
  supplierId          String? // Loose ID reference
  canteenItemId       String? // Loose ID reference
  inKindDetails       Json? // In-kind purchase/cigarette item breakdown
  description         String?
  accountingMonth     String? // YYYY-MM
  isReversal          Boolean   @default(false)
  reversalOfVoucherId String?
  actorTelegramId     BigInt
  receiptPhotoUri     String?
  sha256Checksum      String?
  isDeleted           Boolean   @default(false)
  deletedAt           DateTime?
  deletedBy           BigInt?
  deletionReason      String?
  createdAt           DateTime  @default(now())
  syncedToSheets      Boolean   @default(false)
  syncedAt            DateTime?
  ledgerSeq           BigInt?   @unique @map("ledger_seq")
  hmacKid             String    @default("v1-2026-q1") @map("hmac_kid")
  hmacSignature       String    @default("") @map("hmac_signature")

  worker       Worker?              @relation(fields: [workerId], references: [id])
  installments AdvanceInstallment[]

  @@index([transactionType])
  @@index([sourceAccount])
  @@index([sourceCustodyId])
  @@index([destinationAccount])
  @@index([syncedToSheets])
  @@index([recordHash])
  @@index([previousHash])
  @@index([hashTimestamp])
  @@index([workerId, transactionType])
  @@index([createdAt])
  @@index([accountingMonth])
  @@index([ledgerSeq])
  @@map("financial_ledgers")
}

// -------------------------------------------------------------
// 3. RBAC, Identity, Audit, APM & Drafts
// -------------------------------------------------------------

model User {
  id                     String    @id @default(uuid())
  telegramId             BigInt    @unique
  username               String?
  fullName               String
  role                   String // SUPER_ADMIN, EXECUTIVE, FIELD_ADMIN, ACCOUNTANT, SITE_ENGINEER, WORKER, SUPPLIER, GUEST
  workerId               String?   @unique
  supplierId             String?   @unique // Loose ID reference
  assignedSiteId         String?
  phoneEncrypted         String?
  phoneBlindIndex        String?
  isActive               Boolean   @default(true)
  isBanned               Boolean   @default(false)
  freezeBotAccessOnLeave Boolean   @default(true)
  ejectTelegramOnLeave   Boolean   @default(true)
  approvedBySuperAdminId BigInt?
  isDeleted              Boolean   @default(false)
  deletedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  worker                  Worker?                  @relation(fields: [workerId], references: [id])
  assignedSite            Site?                    @relation(fields: [assignedSiteId], references: [id])
  notifications           NotificationQueue[]
  dashboardSessions       DashboardSession[]
  workerDelegations       WorkerDelegation[]
  supervisorLifecycleLogs SupervisorLifecycleLog[]

  @@index([phoneBlindIndex])
  @@index([role])
  @@map("users")
}

model AuditLog {
  id              String   @id @default(uuid())
  traceId         String?  @db.VarChar(36)
  actorTelegramId BigInt
  actorRole       String
  actionCategory  String // AUTH, USER_MGMT, FINANCIAL, SYSTEM_CONFIG, EXPORT
  targetEntity    String // USER, ADVANCE_REQUEST, SETTING, MIGRATION
  targetEntityId  String?
  changeSummary   String
  beforePayload   Json?
  afterPayload    Json?
  ipAddress       String?
  performedAt     DateTime @default(now())

  @@index([actorTelegramId, performedAt])
  @@index([actionCategory, performedAt])
  @@index([targetEntity, targetEntityId])
  @@map("audit_logs")
}

model BotPerformanceLog {
  id                      String   @id @default(uuid())
  actorTelegramId         BigInt
  callbackQueryOrCommand  String
  executionTimeMs         Int
  internalExecutionTimeMs Int?
  telegramNetworkTimeMs   Int?
  traceId                 String?  @db.VarChar(36)
  module                  String?  @db.VarChar(50)
  flowId                  String?  @db.VarChar(50)
  cacheSource             String?  @default("DB_QUERY") @db.VarChar(20)
  dbQueryCount            Int      @default(0)
  performanceTier         String   @default("GREEN_FAST") // GREEN_FAST, YELLOW_ACCEPTABLE, RED_SLOW
  memoryUsageMb           Decimal? @db.Decimal(8, 2)
  errorMessage            String?
  timestamp               DateTime @default(now())

  @@index([module, timestamp])
  @@index([performanceTier, timestamp])
  @@map("bot_performance_logs")
}

model ApprovalTicket {
  id                String    @id @default(uuid())
  ticketNumber      String    @unique
  workflowType      String // WORKER_ONBOARDING, ADVANCE_REQUEST, EXPENSE_CLAIM, LEAVE_REQUEST
  sourceEntity      String
  sourceEntityId    String
  requestedByUserId BigInt
  requiredRole      String
  status            String    @default("PENDING") // PENDING, APPROVED, REJECTED, EXPIRED
  decisionReason    String?
  decidedByUserId   BigInt?
  decidedAt         DateTime?
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, requiredRole])
  @@index([sourceEntity, sourceEntityId])
  @@map("approval_tickets")
}

model UserWizardDraft {
  id              String   @id @default(uuid())
  actorTelegramId BigInt
  flowIdentifier  String // e.g. "flow:01.1:worker-onboarding"
  wizardState     Json
  lastStepIndex   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([actorTelegramId, flowIdentifier])
  @@map("user_wizard_drafts")
}

model NotificationQueue {
  id                   String    @id @default(uuid())
  recipientTelegramId  BigInt
  recipientUserId      String?
  notificationCategory String // SALARY_NOTICE, ADVANCE_STATUS, SHIFT_ALERT, SYSTEM_BROADCAST
  title                String
  bodyMarkdown         String
  callToActionUrl      String?
  priority             String    @default("NORMAL") // URGENT, HIGH, NORMAL, LOW
  scheduledFor         DateTime  @default(now())
  sentAt               DateTime?
  deliveryStatus       String    @default("QUEUED") // QUEUED, DELIVERED, FAILED, CANCELLED
  retryCount           Int       @default(0)
  failureReason        String?
  createdAt            DateTime  @default(now())

  recipient User? @relation(fields: [recipientUserId], references: [id])

  @@index([deliveryStatus, scheduledFor])
  @@index([recipientTelegramId])
  @@map("notification_queues")
}

model OutboxEvent {
  id             String    @id @default(uuid())
  eventType      String    @default("LEGACY") @map("event_type")
  aggregateId    String?   @map("aggregate_id")
  targetSheet    String    @default("LEGACY") @map("target_sheet")
  payload        Json
  idempotencyKey String?   @unique @map("idempotency_key")
  retryCount     Int       @default(0) @map("retry_count")
  maxRetries     Int       @default(5) @map("max_retries")
  status         String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  errorMessage   String?   @map("error_message")
  lastAttemptAt  DateTime? @map("last_attempt_at")
  nextRetryAt    DateTime? @map("next_retry_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  processedAt    DateTime? @map("processed_at")

  @@index([status, createdAt])
  @@index([status, nextRetryAt])
  @@map("outbox_events")
}

// -------------------------------------------------------------
// 4. System Error Logs & Incident Tracking (Enterprise Crash Vault)
// -------------------------------------------------------------

model SystemErrorLog {
  id              String    @id @default(uuid())
  traceId         String?   @db.VarChar(36)
  service         String    @default("bot-server")
  errorReference  String    @unique // e.g. ERR-7A3F
  errorHash       String
  occurrenceCount Int       @default(1)
  actorTelegramId BigInt?
  actorRole       String?
  actionTrigger   String? // Command or CallbackData e.g. menu:domain:hr
  errorClass      String
  errorMessage    String
  stackTrace      String?
  contextPayload  Json?
  severity        String    @default("CRITICAL") // CRITICAL, WARNING, INFO
  resolved        Boolean   @default(false)
  resolvedAt      DateTime?
  resolvedBy      BigInt?
  resolutionNotes String?
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())

  @@index([errorHash, resolved])
  @@index([firstSeenAt])
  @@index([severity, resolved])
  @@map("system_error_logs")
}

// -------------------------------------------------------------
// 5. Dashboard Authentication & Session Security (SSOT)
// -------------------------------------------------------------

model DashboardAuthLink {
  id              String    @id @default(uuid())
  groupId         String    @db.VarChar(64)
  originKind      String    @default("LOCAL") @db.VarChar(20) // LOCAL, TUNNEL
  targetOrigin    String    @db.VarChar(255) // Full normalized origin e.g. http://localhost:3002
  jtiHash         String    @unique @db.VarChar(64)
  actorTelegramId BigInt
  expiresAt       DateTime
  claimedAt       DateTime?
  claimTraceId    String?   @db.VarChar(36)
  createdAt       DateTime  @default(now())

  @@unique([groupId, originKind])
  @@index([groupId, claimedAt])
  @@index([expiresAt])
  @@index([actorTelegramId])
  @@map("dashboard_auth_links")
}

model DashboardSession {
  id                 String    @id @default(uuid())
  sessionHash        String    @unique @db.VarChar(64)
  userId             String
  actorTelegramId    BigInt
  originKind         String    @default("LOCAL") // LOCAL, TUNNEL
  deviceSummary      String?   @db.VarChar(255)
  userAgentHash      String?   @db.VarChar(64)
  lastSeenAt         DateTime  @default(now())
  expiresAt          DateTime
  maxExpiresAt       DateTime
  extensionCount     Int       @default(0)
  extendedAt         DateTime?
  noticeSentAt       DateTime?
  revokedAt          DateTime?
  revocationReason   String?   @db.VarChar(100)
  permissionsVersion Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([actorTelegramId])
  @@index([expiresAt])
  @@map("dashboard_sessions")
}

// -------------------------------------------------------------
// 6. Dynamic Bot Menus & Hierarchy Enums
// -------------------------------------------------------------

enum BotNodeType {
  MODULE
  SECTION
  SUBSECTION
  FLOW
}

enum BotNodeStatus {
  ACTIVE
  DISABLED
  MAINTENANCE
}

enum DisabledBehavior {
  HIDE
  LOCK_WITH_ALERT
}


// =============================================================
// Module Extension: settings
// =============================================================

// ==============================================================================
// Settings Domain Database Schema (Work Plan 112)
// Models owned by modules/settings
// ==============================================================================

model BotMenuPermission {
  id         String   @id @default(uuid())
  scopeType  String // "ROLE" | "DEPARTMENT" | "JOB_TITLE" | "SITE" | "USER"
  scopeId    String // Role name (e.g. 'FIELD_ADMIN') or UUID of (Department, JobTitle, Site, User)
  featureKey String // e.g. "advances.cash.create", "canteen.sale.create"
  action     String   @default("view") // "view" | "create" | "edit" | "approve" | "export" | "manage"
  policy     String   @default("ALLOW") // "ALLOW" | "DENY" (Explicit DENY trumps ALLOW)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([scopeType, scopeId, featureKey, action])
  @@index([scopeType, scopeId])
  @@index([featureKey, action])
  @@map("bot_menu_permissions")
}

model SupervisorLifecycleLog {
  id              String   @id @default(uuid())
  userId          String
  workerId        String?
  actionType      String // "SITE_TRANSFER" | "LEAVE_START" | "LEAVE_RETURN" | "TERMINATION" | "PROMOTION" | "DEMOTION"
  previousSiteId  String?
  newSiteId       String?
  telegramGroupId BigInt?
  telegramTopicId Int?
  telegramAction  String? // "KICKED" | "BANNED" | "INVITE_SENT" | "RESTORED" | "SKIPPED_POLICY" | "FAILED"
  telegramError   String? // توثيق سبب تعثر استدعاء تيليجرام (مثل CANNOT_REMOVE_ADMIN)
  notes           String?
  actorTelegramId BigInt
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, actionType])
  @@index([createdAt])
  @@map("supervisor_lifecycle_logs")
}

model TelegramEnforcementTask {
  id          String    @id @default(uuid())
  siteId      String
  telegramId  BigInt
  chatId      BigInt
  topicId     Int?
  taskType    String // "KICK_MEMBER" | "BAN_MEMBER" | "GENERATE_INVITE" | "VERIFY_MEMBERSHIP"
  status      String    @default("PENDING") // "PENDING" | "PROCESSING" | "COMPLETED" | "FAILED"
  retryCount  Int       @default(0)
  maxRetries  Int       @default(5)
  lastError   String?
  executeAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, executeAt])
  @@map("telegram_enforcement_tasks")
}

model WorkerDelegation {
  id                    String    @id @default(uuid())
  userId                String
  workerId              String
  permissionKey         String    @db.VarChar(100)
  siteId                String
  resourceId            String?
  startsAt              DateTime  @default(now())
  endsAt                DateTime?
  status                String    @default("ACTIVE") // ACTIVE, REVOKED, EXPIRED
  requestedByTelegramId BigInt
  approvedByTelegramId  BigInt
  revokedByTelegramId   BigInt?
  reason                String?   @db.VarChar(255)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([workerId, status])
  @@index([siteId, status])
  @@index([permissionKey])
  @@map("worker_delegations")
}

model BotMenuNode {
  id                 String           @id @default(uuid())
  code               String           @unique // e.g. "mod:hr", "sec:workforce", "flow:01.1"
  parentId           String? // ربط هرمي بالعنصر الأب
  type               BotNodeType
  title              String // المسمى العربي على الزر
  icon               String? // الرمز التعبيري (مثل: 👥, 💰, 🚜)
  callbackData       String? // كود الكولباك في تليجرام (e.g. "flow:01.1:start")
  status             BotNodeStatus    @default(ACTIVE)
  disabledBehavior   DisabledBehavior @default(LOCK_WITH_ALERT)
  maintenanceMessage String? // نص التنبيه المخصص عند الضغط
  sortOrder          Int              @default(0)
  isProtected        Boolean          @default(false) // وظيفة سيادية غير قابلة للإيقاف مطلقاً
  allowedRoles       String[]         @default(["SUPER_ADMIN", "GENERAL_ADMIN", "FIELD_ADMIN"])
  metadata           Json? // إعدادات التنسيق، عدد الأعمدة، مسار الشريحة

  parent   BotMenuNode?  @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children BotMenuNode[] @relation("MenuHierarchy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, sortOrder])
  @@index([status])
  @@map("bot_menu_nodes")
}

model BotMenuSnapshot {
  id          String   @id @default(uuid())
  title       String // e.g. "قبل صيانة رمضان 2026", "الترتيب الافتراضي للمنظومة"
  data        Json // لقطة كاملة للشجرة
  createdById String
  createdAt   DateTime @default(now())

  @@map("bot_menu_snapshots")
}


// =============================================================
// Module Extension: workforce
// =============================================================

// =============================================================
// Sovereign Workforce Database Schema Fragment (Single Source of Truth)
// Module: @alsaada/module-workforce
// Governed by Work Plan 117 (Sovereign Modular Database Emancipation)
// =============================================================

model Department {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. DEP-OPS, DEP-SEC, DEP-MNT
  name        String
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobTitles JobTitle[]
  workers   Worker[]

  @@map("departments")
}

model JobTitle {
  id                    String   @id @default(uuid())
  departmentId          String
  code                  String   @unique // e.g. JOB-DRV, JOB-HLP, JOB-ENG
  title                 String
  category              String // ADMINISTRATIVE, TECHNICAL, OPERATIONAL, SECURITY, LOGISTICS
  standardWorkingHours  Decimal  @default(10) @db.Decimal(5, 2)
  overtimeHourRateRatio Decimal  @default(1.5) @db.Decimal(4, 2)
  sortOrder             Int      @default(0)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  department    Department         @relation(fields: [departmentId], references: [id])
  salaryHistory JobSalaryHistory[]
  workers       Worker[]

  @@index([departmentId])
  @@map("job_titles")
}

model JobSalaryHistory {
  id            String   @id @default(uuid())
  jobTitleId    String
  minDailyWage  Decimal  @db.Decimal(12, 2)
  maxDailyWage  Decimal  @db.Decimal(12, 2)
  effectiveDate DateTime @default(now())
  changedBy     BigInt?
  reason        String?
  createdAt     DateTime @default(now())

  jobTitle JobTitle @relation(fields: [jobTitleId], references: [id], onDelete: Cascade)

  @@index([jobTitleId, effectiveDate])
  @@map("job_salary_histories")
}

model CycleTransitionHistory {
  id           String    @id @default(uuid())
  workerId     String
  fromCycle    String
  toCycle      String
  transferDate DateTime  @default(now())
  authorizedBy BigInt?
  notes        String?
  isHistorical Boolean   @default(false)
  restDaysDue  Int       @default(0)
  resumedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([workerId, transferDate])
  @@map("cycle_transition_histories")
}

model ShiftCycleTemplate {
  id                  String   @id @default(uuid())
  code                String   @unique // e.g. 24_WORK_6_REST
  name                String
  workDays            Int      @default(24)
  restDays            Int      @default(6)
  travelDaysAllowance Int      @default(2)
  dailyWorkHours      Decimal  @default(10) @db.Decimal(4, 2)
  isDefault           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("shift_cycle_templates")
}

model Worker {
  id                      String    @id @default(uuid())
  code                    String    @unique // Active structured code (e.g. OP-DRV-0042)
  legacyCode              String? // Historical / legacy code (e.g. "106", "101")
  aliases                 String[] // Historical & legacy codes (e.g. ["106", "101", "OP-HLP-0015"])
  name                    String
  nickname                String?
  idType                  String    @default("NATIONAL_ID") // NATIONAL_ID, PASSPORT
  nationality             String    @default("مصر")
  nationalIdEncrypted     String?
  nationalIdBlindIndex    String?   @unique
  passportNumberEncrypted String?
  passportBlindIndex      String?   @unique
  birthDate               DateTime
  gender                  String // MALE, FEMALE
  governorateCode         String    @default("88")
  jobTitle                String
  departmentId            String?
  jobTitleId              String?
  siteId                  String?
  hireDate                DateTime  @default(now())
  contractType            String    @default("PERMANENT") // DAILY_LABOR, SEASONAL, PERMANENT
  shiftSystem             String    @default("24_WORK_6_REST")
  dailyWage               Decimal   @db.Decimal(12, 2)
  basicSalary             Decimal   @default(0) @db.Decimal(12, 2)
  additionalSalary        Decimal   @default(0) @db.Decimal(12, 2)
  fixedAllowances         Decimal   @default(0) @db.Decimal(12, 2)
  paymentMethod           String    @default("CASH_SITE") // CASH_SITE, VODAFONE_CASH, INSTAPAY, BANK_TRANSFER
  accountNumberEncrypted  String?
  walletType              String? // e.g. "محفظة فودافون كاش", "إنستاباي"
  canteenCigarettePolicy  String    @default("NONE") // ONE_PACK_DAILY, FULL_COVERAGE, NONE, CUSTOM
  cigaretteBrand          String?
  canteenItemId           String? // Loose ID reference to Canteen
  walletOwnerName         String?
  instaPayHandle          String?
  insuranceNumber         String?
  insuranceStatus         String?
  ppeShoeSize             String?
  ppeUniformSize          String?
  medicalNotes            String?
  barracksUnit            String?
  bedNumber               String?
  phoneEncrypted          String?
  phoneBlindIndex         String?
  emergencyContactName    String?
  emergencyPhoneEncrypted String?
  drivingLicense          String?
  militaryStatus          String?
  maritalStatus           String?
  previousInsuranceStatus String?
  idCardFrontPath         String?
  idCardBackPath          String?
  idCardExpiryDate        DateTime?
  idCardExpiryAlertSentAt DateTime?
  address                 String?
  telegramId              BigInt?   @unique
  status                  String    @default("ACTIVE") // ACTIVE, ON_LEAVE, TERMINATED, RESIGNED
  terminationDate         DateTime?
  terminationReason       String?
  isDeleted               Boolean   @default(false)
  deletedAt               DateTime?
  deletedBy               BigInt?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  department             Department?             @relation(fields: [departmentId], references: [id])
  jobRef                 JobTitle?               @relation(fields: [jobTitleId], references: [id])
  site                   Site?                   @relation(fields: [siteId], references: [id])
  user                   User?
  salaryHistories        SalaryHistory[]
  changeLogs             WorkerChangeLog[]
  customAllowances       WorkerCustomAllowance[]
  ppeAssets              PPEAsset[]
  disciplinaryAndBonuses DisciplinaryAndBonus[]
  clearance              WorkerClearance?
  balanceSnapshot        WorkerBalanceSnapshot?
  leaves                 Leave[]
  leaveAllowances        LeaveAllowance[]
  ledgers                FinancialLedger[]
  advanceRequests        AdvanceRequest[]
  advanceInstallments    AdvanceInstallment[]
  editRequests           WorkerEditRequest[]
  documents              WorkerDocument[]
  commitmentScores       WorkerCommitmentScore[]

  @@index([phoneBlindIndex])
  @@index([status])
  @@index([isDeleted])
  @@index([legacyCode])
  @@index([idCardExpiryDate])
  @@index([siteId, status])
  @@index([jobTitleId])
  @@index([departmentId])
  @@map("workers")
}

model WorkerDocument {
  id                    String    @id @default(uuid())
  workerId              String
  docType               String // ID_CARD_FRONT, ID_CARD_BACK, DRIVING_LICENSE, CRIMINAL_RECORD, DRUG_TEST, CONTRACT, MEDICAL_REPORT, RESIGNATION_FORM, OTHER
  title                 String
  fileUri               String
  sha256Checksum        String?
  fileSizeBytes         BigInt?
  mimeType              String?
  issueDate             DateTime?
  expiryDate            DateTime?
  alertDaysBeforeExpiry Int       @default(30)
  verifiedByUserId      BigInt?
  isVerified            Boolean   @default(false)
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, docType])
  @@index([expiryDate])
  @@map("worker_documents")
}

model WorkerEditRequest {
  id               String    @id @default(uuid())
  workerId         String
  field            String
  oldValue         String?
  newValue         String
  reason           String?
  status           String    @default("PENDING") // PENDING, APPROVED, REJECTED
  requestedBy      BigInt
  reviewedBy       BigInt?
  reviewedAt       DateTime?
  rejectionReason  String?
  evidencePhotoUri String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, status])
  @@index([status])
  @@map("worker_edit_requests")
}

model SalaryHistory {
  id                   String    @id @default(uuid())
  workerId             String
  previousDailyWage    Decimal   @db.Decimal(12, 2)
  newDailyWage         Decimal   @db.Decimal(12, 2)
  previousBasicSalary  Decimal   @default(0) @db.Decimal(12, 2)
  newBasicSalary       Decimal   @default(0) @db.Decimal(12, 2)
  previousAdditional   Decimal   @default(0) @db.Decimal(12, 2)
  newAdditional        Decimal   @default(0) @db.Decimal(12, 2)
  effectiveDate        DateTime  @default(now())
  reason               String // ANNUAL_INCREASE, PROMOTION, EVALUATION_ADJUSTMENT, PENALTY_DEMOTION, CONTRACT_RENEWAL
  notes                String?
  authorizedByUserId   BigInt?
  letterApprovalDocUri String?
  isApproved           Boolean   @default(true)
  approvedAt           DateTime?
  createdAt            DateTime  @default(now())

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, effectiveDate])
  @@map("salary_histories")
}

model WorkerChangeLog {
  id          String   @id @default(uuid())
  workerId    String
  changeType  String // STATUS_CHANGE, SHIFT_SYSTEM, DAILY_WAGE, DEPARTMENT, JOB_TITLE, SITE_TRANSFER
  fieldName   String
  oldValue    String?
  newValue    String?
  changedBy   BigInt
  reason      String?
  effectiveAt DateTime @default(now())
  createdAt   DateTime @default(now())

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, changeType])
  @@index([effectiveAt])
  @@map("worker_change_logs")
}

model WorkerCustomAllowance {
  id          String    @id @default(uuid())
  workerId    String
  name        String
  amount      Decimal   @db.Decimal(10, 2)
  isRecurring Boolean   @default(true)
  effectiveAt DateTime  @default(now())
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@map("worker_custom_allowances")
}

model PPEAsset {
  id               String    @id @default(uuid())
  workerId         String
  siteId           String
  itemType         String // VEST, HELMET, BOOTS, GLOVES, GLASSES, HARNESS
  serialNumber     String?
  condition        String    @default("NEW") // NEW, GOOD, DAMAGED, LOST
  assignedAt       DateTime  @default(now())
  returnedAt       DateTime?
  deductionApplied Decimal   @default(0) @db.Decimal(10, 2)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  worker Worker @relation(fields: [workerId], references: [id])
  site   Site   @relation(fields: [siteId], references: [id])

  @@index([workerId])
  @@index([siteId])
  @@map("ppe_assets")
}

model DisciplinaryAndBonus {
  id                 String    @id @default(uuid())
  workerId           String
  type               String // BONUS, PENALTY_DAYS, WARNING, DEDUCTION_AMOUNT
  category           String // ATTENDANCE_ABSENCE, SAFETY_VIOLATION, PERFORMANCE, EXCEPTIONAL_WORK, DAMAGE_TO_EQUIPMENT
  amountOrDays       Decimal   @db.Decimal(10, 2)
  description        String
  incidentDate       DateTime
  authorizedByUserId BigInt
  payrollMonth       String?
  isAppliedToPayroll Boolean   @default(false)
  appliedAt          DateTime?
  createdAt          DateTime  @default(now())

  worker Worker @relation(fields: [workerId], references: [id])

  @@index([workerId, isAppliedToPayroll])
  @@index([incidentDate])
  @@map("disciplinary_and_bonuses")
}

model WorkerClearance {
  id                 String    @id @default(uuid())
  clearanceNumber    String    @unique // e.g. #CLR-YYYY-XXXX
  workerId           String    @unique
  reason             String // RESIGNATION, TERMINATION, CONTRACT_END, MEDICAL_INCAPACITY, ABANDONMENT_AWOL
  terminationDate    DateTime
  finalWorkDay       DateTime
  remainingDaysWage  Decimal   @default(0) @db.Decimal(12, 2)
  leaveBalanceRefund Decimal   @default(0) @db.Decimal(12, 2)
  unpaidAdvancesDue  Decimal   @default(0) @db.Decimal(12, 2)
  canteenDebtDue     Decimal   @default(0) @db.Decimal(12, 2)
  damagePenaltiesDue Decimal   @default(0) @db.Decimal(12, 2)
  endOfServiceBonus  Decimal   @default(0) @db.Decimal(12, 2)
  netSettlementTotal Decimal   @db.Decimal(12, 2)
  status             String    @default("PENDING_DEPARTMENT_SIGNS") // PENDING_DEPARTMENT_SIGNS, APPROVED_BY_MANAGEMENT, DISBURSED, ARCHIVED
  settledAt          DateTime?
  disbursedByUserId  BigInt?
  payoutMethod       String    @default("CASH_ENVELOPE")
  payoutReference    String?
  clearanceSheetUri  String?
  sha256Checksum     String?
  recordHash         String    @default("") @map("record_hash")
  previousHash       String?   @map("previous_hash")
  hashTimestamp      DateTime  @default(now()) @map("hash_timestamp")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  worker Worker @relation(fields: [workerId], references: [id])

  @@index([recordHash])
  @@index([previousHash])
  @@index([hashTimestamp])
  @@map("worker_clearances")
}

model WorkerBalanceSnapshot {
  id                   String   @id @default(uuid())
  workerId             String   @unique
  outstandingAdvances  Decimal  @default(0) @db.Decimal(12, 2)
  canteenUnsettledDebt Decimal  @default(0) @db.Decimal(12, 2)
  netAccruedEarnings   Decimal  @default(0) @db.Decimal(12, 2)
  unsettledCustodyDebt Decimal  @default(0) @db.Decimal(12, 2)
  lastCalculatedAt     DateTime @default(now())
  updatedAt            DateTime @updatedAt

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([lastCalculatedAt])
  @@map("worker_balance_snapshots")
}

model WorkerCommitmentScore {
  id               String   @id @default(uuid())
  workerId         String
  siteId           String
  monthYear        String // YYYY-MM
  attendanceRatio  Decimal  @db.Decimal(5, 2)
  safetyScore      Decimal  @db.Decimal(5, 2)
  supervisorsScore Decimal  @db.Decimal(5, 2)
  compositeIndex   Decimal  @db.Decimal(5, 2)
  isEligibleBonus  Boolean  @default(false)
  createdAt        DateTime @default(now())

  worker Worker @relation(fields: [workerId], references: [id])
  site   Site   @relation(fields: [siteId], references: [id])

  @@unique([workerId, monthYear])
  @@index([siteId, monthYear])
  @@map("worker_commitment_scores")
}

model Leave {
  id                    String    @id @default(uuid())
  leaveNumber           String    @unique // e.g. #LV-YYYY-XXXX
  workerId              String
  siteId                String
  leaveType             String    @default("ANNUAL") // ANNUAL, CASUAL, MISSION, SICK, UNPAID
  requestDate           DateTime  @default(now())
  departureDate         DateTime
  expectedReturnDate    DateTime
  actualReturnDate      DateTime?
  status                String    @default("PENDING") // PENDING, APPROVED, REJECTED, ACTIVE_ON_LEAVE, RESUMED, OVERDUE
  overdueDays           Int       @default(0)
  penaltyDaysCalculated Decimal   @default(0) @db.Decimal(6, 2)
  deductionAmount       Decimal   @default(0) @db.Decimal(12, 2)
  isOverstayPardoned    Boolean   @default(false)
  overstayPardonReason  String?
  supervisorNotes       String?
  approvedByUserId      BigInt?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  worker     Worker           @relation(fields: [workerId], references: [id])
  site       Site             @relation(fields: [siteId], references: [id])
  allowances LeaveAllowance[]

  @@index([workerId, status])
  @@index([siteId, departureDate])
  @@map("leaves")
}

model LeaveAllowance {
  id                     String   @id @default(uuid())
  leaveId                String
  workerId               String
  travelStipend          Decimal  @db.Decimal(10, 2)
  disbursedFromCustodyId String?  // Loose ID reference to Custody
  disbursementDate       DateTime @default(now())
  voucherNumber          String?
  createdAt              DateTime @default(now())

  leave  Leave  @relation(fields: [leaveId], references: [id])
  worker Worker @relation(fields: [workerId], references: [id])

  @@map("leave_allowances")
}

model AdvanceRequest {
  id                 String    @id @default(uuid())
  requestNumber      String    @unique // e.g. #ADV-YYYY-XXXX
  workerId           String
  siteId             String?
  amountRequested    Decimal   @db.Decimal(12, 2)
  amountApproved     Decimal?  @db.Decimal(12, 2)
  purpose            String
  status             String    @default("PENDING") // PENDING, APPROVED, REJECTED, DISBURSED, CANCELLED
  rejectionReason    String?
  approvedByUserId   BigInt?
  disbursedAt        DateTime?
  monthlyInstallment Decimal?  @db.Decimal(10, 2)
  installmentCount   Int       @default(1)
  remainingBalance   Decimal   @default(0) @db.Decimal(12, 2)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  worker Worker @relation(fields: [workerId], references: [id])
  site   Site?  @relation(fields: [siteId], references: [id])

  @@index([workerId, status])
  @@index([siteId, createdAt])
  @@map("advance_requests")
}

model AdvanceInstallment {
  id                    String    @id @default(uuid())
  workerId              String
  originalVoucherNumber String
  installmentSequence   Int
  dueMonth              String // YYYY-MM
  installmentAmount     Decimal   @db.Decimal(12, 2)
  actualDeductedAmount  Decimal   @default(0) @db.Decimal(12, 2)
  status                String    @default("SCHEDULED") // SCHEDULED, DEDUCTED_FULL, DEDUCTED_PARTIAL, POSTPONED, WAIVED
  payrollRunId          String?   // Loose ID reference to Payroll
  deductedAt            DateTime?
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  worker          Worker           @relation(fields: [workerId], references: [id])
  financialLedger FinancialLedger? @relation(fields: [originalVoucherNumber], references: [voucherNumber])

  @@index([workerId, dueMonth])
  @@index([status])
  @@map("advance_installments")
}
