// 11. RBAC, Identity, Audit, APM & Drafts
// -------------------------------------------------------------

model User {
  id                     String    @id @default(uuid())
  telegramId             BigInt    @unique
  username               String?
  fullName               String
  role                   String // SUPER_ADMIN, EXECUTIVE, FIELD_ADMIN, ACCOUNTANT, SITE_ENGINEER, WORKER, SUPPLIER, GUEST
  workerId               String?   @unique
  supplierId             String?   @unique
  assignedSiteId         String?
  phoneEncrypted         String?
  phoneBlindIndex        String?
  isActive               Boolean   @default(true)
  isBanned               Boolean   @default(false)
  freezeBotAccessOnLeave Boolean   @default(true)
  ejectTelegramOnLeave   Boolean   @default(true)
  approvedBySuperAdminId BigInt?
  isDeleted              Boolean   @default(false)
  deletedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  worker                  Worker?                  @relation(fields: [workerId], references: [id])
  supplier                Supplier?                @relation(fields: [supplierId], references: [id])
  assignedSite            Site?                    @relation(fields: [assignedSiteId], references: [id])
  notifications           NotificationQueue[]
  dashboardSessions       DashboardSession[]
  workerDelegations       WorkerDelegation[]
  supervisorLifecycleLogs SupervisorLifecycleLog[]

  @@index([phoneBlindIndex])
  @@index([role])
  @@map("users")
}







model AuditLog {
  id              String   @id @default(uuid())
  traceId         String?  @db.VarChar(36)
  actorTelegramId BigInt
  action          String
  entityType      String
  entityId        String
  beforePayload   Json?
  afterPayload    Json?
  ipAddress       String?
  timestamp       DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorTelegramId, timestamp])
  @@map("audit_logs")
}

model BotPerformanceLog {
  id                      String   @id @default(uuid())
  actorTelegramId         BigInt
  callbackQueryOrCommand  String
  executionTimeMs         Int
  internalExecutionTimeMs Int?
  telegramNetworkTimeMs   Int?
  traceId                 String?  @db.VarChar(36)
  module                  String?  @db.VarChar(50)
  flowId                  String?  @db.VarChar(50)
  cacheSource             String?  @default("DB_QUERY") @db.VarChar(20)
  dbQueryCount            Int      @default(0)
  performanceTier         String   @default("GREEN_FAST") // GREEN_FAST, YELLOW_ACCEPTABLE, RED_SLOW
  memoryUsageMb           Decimal? @db.Decimal(8, 2)
  errorMessage            String?
  timestamp               DateTime @default(now())

  @@index([module, timestamp])
  @@index([performanceTier, timestamp])
  @@map("bot_performance_logs")
}

model ApprovalTicket {
  id                    String    @id @default(uuid())
  ticketNumber          String    @unique // e.g. #TCK-YYYY-XXXX
  ticketType            String // LEAVE_REQUEST, ADVANCE_REQUEST, TRANSACTION_MODIFICATION, WORKER_EDIT, PPE_REPLACEMENT, SPARE_PARTS_PURCHASE, CUSTODY_LIQUIDATION, END_OF_SERVICE_CLEARANCE
  entityId              String
  requestedByTelegramId BigInt
  status                String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewDecisionNotes   String?
  reviewedByTelegramId  BigInt?
  reviewedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status, ticketType])
  @@map("approval_tickets")
}

model UserWizardDraft {
  id          String   @id @default(uuid())
  telegramId  BigInt   @unique
  wizardName  String
  currentStep String
  draftData   Json
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt

  @@map("user_wizard_drafts")
}

model NotificationQueue {
  id                  String    @id @default(uuid())
  recipientTelegramId BigInt
  userId              String?
  priority            String    @default("GENERAL_ALERT") // CRITICAL_SECURITY, FINANCIAL_RECEIPT, GENERAL_ALERT
  messageText         String
  inlineKeyboard      Json?
  status              String    @default("PENDING") // PENDING, DISPATCHING, DELIVERED, FAILED_RETRYING, EXHAUSTED
  retryCount          Int       @default(0)
  scheduledFor        DateTime  @default(now())
  deliveredAt         DateTime?
  errorMessage        String?
  createdAt           DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([status, scheduledFor, priority])
  @@map("notification_dispatch_queues")
}

// -------------------------------------------------------------
// 12. Transactional Outbox (Reliable Hybrid Sync)
// -------------------------------------------------------------

model OutboxEvent {
  id             String    @id @default(uuid())
  eventType      String    @default("LEGACY") @map("event_type")
  aggregateId    String?   @map("aggregate_id")
  targetSheet    String    @default("LEGACY") @map("target_sheet")
  payload        Json
  idempotencyKey String?   @unique @map("idempotency_key")
  retryCount     Int       @default(0) @map("retry_count")
  maxRetries     Int       @default(5) @map("max_retries")
  status         String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  errorMessage   String?   @map("error_message")
  lastAttemptAt  DateTime? @map("last_attempt_at")
  nextRetryAt    DateTime? @map("next_retry_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  processedAt    DateTime? @map("processed_at")

  @@index([status, createdAt])
  @@index([status, nextRetryAt])
  @@map("outbox_events")
}

model DeadLetterEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique @map("event_id")
  eventType   String   @map("event_type")
  aggregateId String?  @map("aggregate_id")
  payload     Json
  retryCount  Int      @map("retry_count")
  lastError   String?  @map("last_error")
  createdAt   DateTime @default(now()) @map("created_at")
  movedAt     DateTime @default(now()) @map("moved_at")

  @@index([eventType])
  @@index([movedAt])
  @@map("dead_letter_events")
}

// -------------------------------------------------------------
// 13. System Error Logs & Incident Tracking (Enterprise Crash Vault)
// -------------------------------------------------------------

model SystemErrorLog {
  id              String    @id @default(uuid())
  traceId         String?   @db.VarChar(36)
  service         String    @default("bot-server")
  errorReference  String    @unique // e.g. ERR-7A3F
  errorHash       String
  occurrenceCount Int       @default(1)
  actorTelegramId BigInt?
  actorRole       String?
  actionTrigger   String? // Command or CallbackData e.g. menu:domain:hr
  sourceLocation  String? // Module / Handler / Function
  errorMessage    String
  stackTrace      String?
  breadcrumbs     Json? // Array of last 5 user interaction steps
  severity        String    @default("ERROR") // WARNING, ERROR, CRITICAL, FATAL
  isResolved      Boolean   @default(false)
  resolvedAt      DateTime?
  resolvedById    BigInt?
  createdAt       DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())

  @@index([severity, createdAt])
  @@index([errorHash, isResolved])
  @@index([actorTelegramId, createdAt])
  @@map("system_error_logs")
}

// -------------------------------------------------------------
// 14. Dashboard Authentication, Sessions & RBAC Delegations
// -------------------------------------------------------------

model DashboardAuthLink {
  id              String    @id @default(uuid())
  groupId         String    @db.VarChar(64)
  originKind      String    @default("LOCAL") @db.VarChar(20) // LOCAL, TUNNEL
  targetOrigin    String    @db.VarChar(255) // Full normalized origin e.g. http://localhost:3002
  jtiHash         String    @unique @db.VarChar(64)
  actorTelegramId BigInt
  expiresAt       DateTime
  claimedAt       DateTime?
  claimTraceId    String?   @db.VarChar(36)
  createdAt       DateTime  @default(now())

  @@unique([groupId, originKind])
  @@index([groupId, claimedAt])
  @@index([expiresAt])
  @@index([actorTelegramId])
  @@map("dashboard_auth_links")
}

model DashboardSession {
  id                 String    @id @default(uuid())
  sessionHash        String    @unique @db.VarChar(64)
  userId             String
  actorTelegramId    BigInt
  originKind         String    @default("LOCAL") // LOCAL, TUNNEL
  deviceSummary      String?   @db.VarChar(255)
  userAgentHash      String?   @db.VarChar(64)
  lastSeenAt         DateTime  @default(now())
  expiresAt          DateTime
  maxExpiresAt       DateTime
  extensionCount     Int       @default(0)
  extendedAt         DateTime?
  noticeSentAt       DateTime?
  revokedAt          DateTime?
  revocationReason   String?   @db.VarChar(100)
  permissionsVersion Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([actorTelegramId])
  @@index([expiresAt])
  @@map("dashboard_sessions")
}



// -------------------------------------------------------------
// 13. Dynamic Bot Modules, Flows & Menu Hierarchy (Plan-71)
// -------------------------------------------------------------

enum BotNodeType {
  MODULE // النطاق العام (الموارد البشرية، المالية، التشغيل، اللوجستيات، الحوكمة)
  SECTION // القسم الرئيسي (شؤون العاملين، السلف، العهد...)
  SUBSECTION // القسم الفرعي (إن وجد)
  FLOW // زر التدفق الإجرائي المباشر (مثل: تسجيل عامل 01.1)
}

enum BotNodeStatus {
  ACTIVE // مفعل ويعمل بكفاءة
  DISABLED // موقوف
  MAINTENANCE // تحت الصيانة والتحديث
}

enum DisabledBehavior {
  HIDE // إخفاء الزر تماماً من لوحة مفاتيح البوت
  LOCK_WITH_ALERT // إبقاء الزر مع رمز قفل 🔒 ورسالة تنبيه منبثقة Modal Alert
}



