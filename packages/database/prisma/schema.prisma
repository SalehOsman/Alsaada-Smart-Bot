// =============================================================
// Sovereign Core Database Schema (Single Source of Truth)
// Packages: @alsaada/database
// Governed by Work Plan 117 (Sovereign Modular Database Emancipation)
// Contains strictly Core Shared Kernel models (Zero Ghost Models)
// =============================================================

datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
  output          = "../src/generated/client"
}

// -------------------------------------------------------------
// 1. Core Enterprise Entities (Company, Projects, Sites)
// -------------------------------------------------------------

model CompanyProfile {
  id                           String   @id @default(uuid())
  legalName                    String
  tradeName                    String
  taxRegistrationNumber        String?
  commercialRegistrationNumber String?
  headquartersAddress          String?
  primaryPhone                 String?
  officialEmail                String?
  baseCurrency                 String   @default("EGP")
  settings                     Json?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  @@map("company_profiles")
}

model Project {
  id              String    @id @default(uuid())
  code            String    @unique // e.g. PRJ-PHOS-01
  name            String
  clientName      String?
  startDate       DateTime?
  endDate         DateTime?
  estimatedBudget Decimal?  @db.Decimal(14, 2)
  status          String    @default("ACTIVE") // PLANNING, ACTIVE, SUSPENDED, COMPLETED
  description     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sites Site[]

  @@map("projects")
}

model Site {
  id                   String   @id @default(uuid())
  projectId            String
  code                 String   @unique // e.g. STE-KHA, STE-ASW
  name                 String
  governorateCode      String?
  latitude             Decimal? @db.Decimal(10, 7)
  longitude            Decimal? @db.Decimal(10, 7)
  geofenceRadiusMeters Int?     @default(1000)
  status               String   @default("ACTIVE") // ACTIVE, INACTIVE
  telegramGroupId      BigInt?
  telegramTopicId      Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  project           Project                 @relation(fields: [projectId], references: [id])
  users             User[]
  workers           Worker[]
  leaves            Leave[]
  advanceRequests   AdvanceRequest[]
  ppeAssets         PPEAsset[]
  commitmentScores  WorkerCommitmentScore[]
  workerDelegations WorkerDelegation[]

  @@map("sites")
}

// -------------------------------------------------------------
// 2. Financial Ledger & Cumulative Hash Chain
// -------------------------------------------------------------

model FinancialLedger {
  id                  String    @id @default(uuid())
  voucherNumber       String    @unique // e.g. #ADV-YYYY-XXXX, #PAY-YYYY-XXXX
  recordHash          String    @default("") @map("record_hash")
  previousHash        String?   @map("previous_hash")
  hashTimestamp       DateTime  @default(now()) @map("hash_timestamp")
  transactionType     String // ADVANCE_CASH, WITHDRAWAL_CIGARETTES, WITHDRAWAL_PURCHASES, SALARY_PAYOUT, SUPPLIER_PAYMENT, CUSTODY_DISBURSEMENT, CUSTODY_REFUND, GENERAL_EXPENSE
  amount              Decimal   @db.Decimal(14, 2)
  currency            String    @default("EGP")
  sourceAccount       String
  destinationAccount  String
  sourceCustodyId     String? // Loose ID reference
  workerId            String?
  supplierId          String? // Loose ID reference
  canteenItemId       String? // Loose ID reference
  inKindDetails       Json? // In-kind purchase/cigarette item breakdown
  description         String?
  accountingMonth     String? // YYYY-MM
  isReversal          Boolean   @default(false)
  reversalOfVoucherId String?
  actorTelegramId     BigInt
  receiptPhotoUri     String?
  sha256Checksum      String?
  isDeleted           Boolean   @default(false)
  deletedAt           DateTime?
  deletedBy           BigInt?
  deletionReason      String?
  createdAt           DateTime  @default(now())
  syncedToSheets      Boolean   @default(false)
  syncedAt            DateTime?
  ledgerSeq           BigInt?   @unique @map("ledger_seq")
  hmacKid             String    @default("v1-2026-q1") @map("hmac_kid")
  hmacSignature       String    @default("") @map("hmac_signature")

  worker       Worker?              @relation(fields: [workerId], references: [id])
  installments AdvanceInstallment[]

  @@index([transactionType])
  @@index([sourceAccount])
  @@index([sourceCustodyId])
  @@index([destinationAccount])
  @@index([syncedToSheets])
  @@index([recordHash])
  @@index([previousHash])
  @@index([hashTimestamp])
  @@index([workerId, transactionType])
  @@index([createdAt])
  @@index([accountingMonth])
  @@index([ledgerSeq])
  @@map("financial_ledgers")
}

// -------------------------------------------------------------
// 3. RBAC, Identity, Audit, APM & Drafts
// -------------------------------------------------------------

model User {
  id                     String    @id @default(uuid())
  telegramId             BigInt    @unique
  username               String?
  fullName               String
  role                   String // SUPER_ADMIN, EXECUTIVE, FIELD_ADMIN, ACCOUNTANT, SITE_ENGINEER, WORKER, SUPPLIER, GUEST
  workerId               String?   @unique
  supplierId             String?   @unique // Loose ID reference
  assignedSiteId         String?
  phoneEncrypted         String?
  phoneBlindIndex        String?
  isActive               Boolean   @default(true)
  isBanned               Boolean   @default(false)
  freezeBotAccessOnLeave Boolean   @default(true)
  ejectTelegramOnLeave   Boolean   @default(true)
  approvedBySuperAdminId BigInt?
  isDeleted              Boolean   @default(false)
  deletedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  worker                  Worker?                  @relation(fields: [workerId], references: [id])
  assignedSite            Site?                    @relation(fields: [assignedSiteId], references: [id])
  notifications           NotificationQueue[]
  dashboardSessions       DashboardSession[]
  workerDelegations       WorkerDelegation[]
  supervisorLifecycleLogs SupervisorLifecycleLog[]

  @@index([phoneBlindIndex])
  @@index([role])
  @@map("users")
}

model AuditLog {
  id              String   @id @default(uuid())
  traceId         String?  @db.VarChar(36)
  actorTelegramId BigInt
  actorRole       String
  actionCategory  String // AUTH, USER_MGMT, FINANCIAL, SYSTEM_CONFIG, EXPORT
  targetEntity    String // USER, ADVANCE_REQUEST, SETTING, MIGRATION
  targetEntityId  String?
  changeSummary   String
  beforePayload   Json?
  afterPayload    Json?
  ipAddress       String?
  performedAt     DateTime @default(now())

  @@index([actorTelegramId, performedAt])
  @@index([actionCategory, performedAt])
  @@index([targetEntity, targetEntityId])
  @@map("audit_logs")
}

model BotPerformanceLog {
  id                    String   @id @default(uuid())
  traceId               String   @db.VarChar(36)
  flowId                String
  stepId                String
  actorTelegramId       BigInt
  networkLatencyMs      Int      @default(0)
  dbQueryDurationMs     Int      @default(0)
  totalExecutionMs      Int      @default(0)
  memoryDeltaKb         Int      @default(0)
  slaThresholdMs        Int      @default(1500)
  slaBreached           Boolean  @default(false)
  isThrottled           Boolean  @default(false)
  isCacheHit            Boolean  @default(false)
  concurrencyLockWaitMs Int      @default(0)
  timestamp             DateTime @default(now())

  @@index([flowId, timestamp])
  @@index([actorTelegramId, timestamp])
  @@index([slaBreached])
  @@map("bot_performance_logs")
}

model ApprovalTicket {
  id                String    @id @default(uuid())
  ticketNumber      String    @unique
  workflowType      String // WORKER_ONBOARDING, ADVANCE_REQUEST, EXPENSE_CLAIM, LEAVE_REQUEST
  sourceEntity      String
  sourceEntityId    String
  requestedByUserId BigInt
  requiredRole      String
  status            String    @default("PENDING") // PENDING, APPROVED, REJECTED, EXPIRED
  decisionReason    String?
  decidedByUserId   BigInt?
  decidedAt         DateTime?
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, requiredRole])
  @@index([sourceEntity, sourceEntityId])
  @@map("approval_tickets")
}

model UserWizardDraft {
  id              String   @id @default(uuid())
  actorTelegramId BigInt
  flowIdentifier  String // e.g. "flow:01.1:worker-onboarding"
  wizardState     Json
  lastStepIndex   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([actorTelegramId, flowIdentifier])
  @@map("user_wizard_drafts")
}

model NotificationQueue {
  id                   String    @id @default(uuid())
  recipientTelegramId  BigInt
  recipientUserId      String?
  notificationCategory String // SALARY_NOTICE, ADVANCE_STATUS, SHIFT_ALERT, SYSTEM_BROADCAST
  title                String
  bodyMarkdown         String
  callToActionUrl      String?
  priority             String    @default("NORMAL") // URGENT, HIGH, NORMAL, LOW
  scheduledFor         DateTime  @default(now())
  sentAt               DateTime?
  deliveryStatus       String    @default("QUEUED") // QUEUED, DELIVERED, FAILED, CANCELLED
  retryCount           Int       @default(0)
  failureReason        String?
  createdAt            DateTime  @default(now())

  recipient User? @relation(fields: [recipientUserId], references: [id])

  @@index([deliveryStatus, scheduledFor])
  @@index([recipientTelegramId])
  @@map("notification_queues")
}

model OutboxEvent {
  id             String    @id @default(uuid())
  eventType      String    @default("LEGACY") @map("event_type")
  aggregateId    String?   @map("aggregate_id")
  targetSheet    String    @default("LEGACY") @map("target_sheet")
  payload        Json
  idempotencyKey String?   @unique @map("idempotency_key")
  retryCount     Int       @default(0) @map("retry_count")
  maxRetries     Int       @default(5) @map("max_retries")
  status         String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  errorMessage   String?   @map("error_message")
  lastAttemptAt  DateTime? @map("last_attempt_at")
  nextRetryAt    DateTime? @map("next_retry_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  processedAt    DateTime? @map("processed_at")

  @@index([status, createdAt])
  @@index([status, nextRetryAt])
  @@map("outbox_events")
}

// -------------------------------------------------------------
// 4. System Error Logs & Incident Tracking (Enterprise Crash Vault)
// -------------------------------------------------------------

model SystemErrorLog {
  id              String    @id @default(uuid())
  traceId         String?   @db.VarChar(36)
  service         String    @default("bot-server")
  errorReference  String    @unique // e.g. ERR-7A3F
  errorHash       String
  occurrenceCount Int       @default(1)
  actorTelegramId BigInt?
  actorRole       String?
  actionTrigger   String? // Command or CallbackData e.g. menu:domain:hr
  errorClass      String
  errorMessage    String
  stackTrace      String?
  contextPayload  Json?
  severity        String    @default("CRITICAL") // CRITICAL, WARNING, INFO
  resolved        Boolean   @default(false)
  resolvedAt      DateTime?
  resolvedBy      BigInt?
  resolutionNotes String?
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())

  @@index([errorHash, resolved])
  @@index([firstSeenAt])
  @@index([severity, resolved])
  @@map("system_error_logs")
}

// -------------------------------------------------------------
// 5. Dashboard Authentication & Session Security (SSOT)
// -------------------------------------------------------------

model DashboardAuthLink {
  id              String    @id @default(uuid())
  groupId         String    @db.VarChar(64)
  originKind      String    @default("LOCAL") @db.VarChar(20) // LOCAL, TUNNEL
  targetOrigin    String    @db.VarChar(255) // Full normalized origin e.g. http://localhost:3002
  jtiHash         String    @unique @db.VarChar(64)
  actorTelegramId BigInt
  expiresAt       DateTime
  claimedAt       DateTime?
  claimTraceId    String?   @db.VarChar(36)
  createdAt       DateTime  @default(now())

  @@unique([groupId, originKind])
  @@index([groupId, claimedAt])
  @@index([expiresAt])
  @@index([actorTelegramId])
  @@map("dashboard_auth_links")
}

model DashboardSession {
  id                 String    @id @default(uuid())
  sessionHash        String    @unique @db.VarChar(64)
  userId             String
  actorTelegramId    BigInt
  originKind         String    @default("LOCAL") // LOCAL, TUNNEL
  deviceSummary      String?   @db.VarChar(255)
  userAgentHash      String?   @db.VarChar(64)
  lastSeenAt         DateTime  @default(now())
  expiresAt          DateTime
  maxExpiresAt       DateTime
  extensionCount     Int       @default(0)
  extendedAt         DateTime?
  noticeSentAt       DateTime?
  revokedAt          DateTime?
  revocationReason   String?   @db.VarChar(100)
  permissionsVersion Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([actorTelegramId])
  @@index([expiresAt])
  @@map("dashboard_sessions")
}

// -------------------------------------------------------------
// 6. Dynamic Bot Menus & Hierarchy Enums
// -------------------------------------------------------------

enum BotNodeType {
  MODULE
  SECTION
  SUBSECTION
  FLOW
}

enum BotNodeStatus {
  ACTIVE
  DISABLED
  MAINTENANCE
}

enum DisabledBehavior {
  HIDE
  LOCK_WITH_ALERT
}
