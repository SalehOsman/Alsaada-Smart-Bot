// ==============================================================================
// Al-Saada Smart Bot Enterprise Database Schema (PostgreSQL 16)
// Complete 12-Domain Enterprise Relational Architecture (Replacing 66 Sheets)
// ==============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// 1. Tenant, Corporate Profile & Projects Master Data
// -------------------------------------------------------------

model Tenant {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profiles    CompanyProfile[]
  projects    Project[]
  departments Department[]
  users       User[]
  workers     Worker[]
  treasuries  CompanyTreasury[]
  suppliers   Supplier[]
  equipments  Equipment[]
  payrollRuns PayrollRun[]
  documents   CompanyDocument[]
  expenseClaims WorkerExpenseClaim[]

  @@map("tenants")
}

model CompanyProfile {
  id                           String   @id @default(uuid())
  tenantId                     String
  legalName                    String
  tradeName                    String
  taxRegistrationNumber        String?
  commercialRegistrationNumber String?
  headquartersAddress          String?
  primaryPhone                 String?
  officialEmail                String?
  baseCurrency                 String   @default("EGP")
  settings                     Json?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("company_profiles")
}

model Project {
  id              String    @id @default(uuid())
  tenantId        String
  code            String    @unique // e.g. PRJ-PHOS-01
  name            String
  clientName      String?
  startDate       DateTime?
  endDate         DateTime?
  estimatedBudget Decimal?  @db.Decimal(14, 2)
  status          String    @default("ACTIVE") // PLANNING, ACTIVE, SUSPENDED, COMPLETED
  description     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  sites             Site[]
  phosphateExtracts PhosphateExtract[]

  @@map("projects")
}

model Site {
  id                   String    @id @default(uuid())
  projectId            String
  code                 String    @unique // e.g. STE-KHA, STE-ASW
  name                 String
  governorateCode      String?
  latitude             Decimal?  @db.Decimal(10, 7)
  longitude            Decimal?  @db.Decimal(10, 7)
  geofenceRadiusMeters Int?      @default(1000)
  status               String    @default("ACTIVE") // ACTIVE, INACTIVE
  telegramGroupId      BigInt?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  project          Project                  @relation(fields: [projectId], references: [id])
  workers          Worker[]
  accommodations   SiteAccommodation[]
  custodies        FinancialCustody[]
  equipments       Equipment[]
  fuelTanks        FuelTank[]
  canteenItems     CanteenItem[]
  campFoodItems    CampFoodItem[]
  foodShipments    FoodInboundShipment[]
  kitchenDispenses KitchenMealDispense[]
  foodWasteLogs    FoodWasteLog[]
  mealSurveys      MealSurvey[]
  phosphateSlips   PhosphateProductionSlip[]
  leaves           Leave[]
  dutyRosters      DutyRoster[]
  tasks            SiteTask[]
  hospitality      HospitalityExpense[]
  supplierInvoices SupplierInvoice[]
  users             User[]
  expenseClaims     WorkerExpenseClaim[]
  workerDelegations WorkerDelegation[]

  @@map("sites")
}

model SiteAccommodation {
  id               String   @id @default(uuid())
  siteId           String
  unitNumber       String   // e.g. CRV-04
  unitType         String   @default("WORKER_BARRACKS") // ENGINEER_CABIN, WORKER_BARRACKS, VIP_GUEST
  capacity         Int      @default(4)
  currentOccupancy Int      @default(0)
  supervisorName   String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  site        Site                          @relation(fields: [siteId], references: [id])
  assignments SiteAccommodationAssignment[]

  @@map("site_accommodations")
}

model SiteAccommodationAssignment {
  id              String    @id @default(uuid())
  accommodationId String
  workerId        String
  bedNumber       String?
  checkInDate     DateTime  @default(now())
  checkOutDate    DateTime?
  status          String    @default("ACTIVE") // ACTIVE, CHECKED_OUT
  notes           String?

  accommodation SiteAccommodation @relation(fields: [accommodationId], references: [id])
  worker        Worker            @relation(fields: [workerId], references: [id])

  @@map("site_accommodation_assignments")
}

model CompanyDocument {
  id                    String    @id @default(uuid())
  tenantId              String
  docNumber             String
  title                 String
  category              String    // LEGAL_REGISTRATION, QUARRY_LICENSE, EQUIPMENT_TITLE, LEASE_CONTRACT, TAX_RECORD
  issueDate             DateTime?
  expiryDate            DateTime?
  fileUri               String
  sha256Checksum        String?
  fileSizeBytes         BigInt?
  alertDaysBeforeExpiry Int       @default(30)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("company_documents")
}

// -------------------------------------------------------------
// 2. Organizational Hierarchy & Workforce 360 Registry
// -------------------------------------------------------------

model Department {
  id          String   @id @default(uuid())
  tenantId    String?
  code        String   @unique // e.g. OP, FL, MNT, SEC, ADM
  name        String   // e.g. إدارة التشغيل والمعدات
  order       Int      @default(99)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant?    @relation(fields: [tenantId], references: [id])
  jobs    JobTitle[]
  workers Worker[]

  @@map("departments")
}

model JobTitle {
  id                String   @id @default(uuid())
  departmentId      String
  code              String   // e.g. DRV, HLP, TEC, OPR, ENG
  name              String   // e.g. سائق لودر
  baseSalary        Decimal  @default(0) @db.Decimal(12, 2)
  additionalSalary  Decimal  @default(0) @db.Decimal(12, 2)
  baseWageGuideline Decimal? @db.Decimal(12, 2)
  workDays          Int      @default(20)
  restDays          Int      @default(10)
  totalCycleDays    Int      @default(30)
  shiftNature       String   @default("دورة قياسية (20+10)")
  minHeadcount      Int      @default(1)
  order             Int      @default(99)
  notes             String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  department Department @relation(fields: [departmentId], references: [id])
  workers    Worker[]

  @@unique([departmentId, code])
  @@map("job_titles")
}

model CycleTransitionHistory {
  id               String   @id @default(uuid())
  targetType       String   // "JOB_TITLE" | "SITE" | "WORKER"
  targetId         String   // ID of JobTitle or Site or Worker
  targetCode       String?  // Code e.g. DRV, STE-01, OP-DRV-0042
  targetName       String?  // Name e.g. سائق لودر
  
  // Previous cycle
  previousWorkDays Int
  previousRestDays Int
  previousRatio    Decimal  @db.Decimal(6, 4) // e.g. 0.5000
  
  // New cycle
  newWorkDays      Int
  newRestDays      Int
  newRatio         Decimal  @db.Decimal(6, 4) // e.g. 0.2500
  
  // Transition policy & Effective date
  transitionPolicy String   @default("IMMEDIATE_PRORATED") // "IMMEDIATE_PRORATED" | "NEXT_CYCLE" | "NEW_HIRES_ONLY" | "CUSTOM_DATE"
  effectiveDate    DateTime @default(now())
  appliedByAdminId BigInt?
  notes            String?
  
  createdAt        DateTime @default(now())

  @@index([targetType, targetId, effectiveDate])
  @@index([effectiveDate])
  @@map("cycle_transition_history")
}

model Worker {
  id                     String    @id @default(uuid())
  tenantId               String?
  code                   String    @unique // Active structured code (e.g. OP-DRV-0042)
  legacyCode             String?   // Historical / legacy code (e.g. "106", "101")
  aliases                String[]  // Historical & legacy codes (e.g. ["106", "101", "OP-HLP-0015"])
  name                   String
  nickname               String?
  idType                 String    @default("NATIONAL_ID") // NATIONAL_ID, PASSPORT
  nationality            String    @default("مصر")
  nationalIdEncrypted    String?
  nationalIdBlindIndex   String?   @unique
  passportNumberEncrypted String?
  passportBlindIndex     String?   @unique
  birthDate              DateTime
  gender                 String    // MALE, FEMALE
  governorateCode        String    @default("88")
  jobTitle               String
  departmentId           String?
  jobTitleId             String?
  siteId                 String?
  hireDate               DateTime  @default(now())
  contractType           String    @default("DAILY_LABOR") // DAILY_LABOR, SEASONAL, PERMANENT
  shiftSystem            String    @default("24_WORK_6_REST")
  dailyWage              Decimal   @db.Decimal(12, 2)
  basicSalary            Decimal   @default(0) @db.Decimal(12, 2)
  fixedAllowances        Decimal   @default(0) @db.Decimal(12, 2)
  paymentMethod          String    @default("CASH_SITE") // CASH_SITE, VODAFONE_CASH, INSTAPAY, BANK_TRANSFER
  accountNumberEncrypted String?
  walletType             String?   // e.g. "محفظة فودافون كاش", "إنستاباي"
  canteenCigarettePolicy String    @default("NONE") // ONE_PACK_DAILY, FULL_COVERAGE, NONE, CUSTOM
  cigaretteBrand         String?   // نوع / صنف السجائر المعتمد للعامل
  canteenItemId          String?   // معرف صنف السجائر من جدول مخزن الكانتين
  walletOwnerName        String?   // اسم صاحب المحفظة
  instaPayHandle         String?   // معرف إنستاباي
  insuranceNumber        String?   // الرقم التأميني المكون من 8-10 أرقام
  insuranceStatus        String?   // الموقف من التأمينات (مؤمن عليه حالياً، مؤمن سابقاً، غير مؤمن، متفرغ)
  ppeShoeSize            String?   // مقاس حذاء السلامة السيفتي (41-46)
  ppeUniformSize         String?   // مقاس الأفرول / الزي الميداني (M-4XL)
  medicalNotes           String?   // الأمراض المزمنة، الحساسية، الملاحظات الطبية
  barracksUnit           String?   // مقر السكن / رقم الكرفان أو العنبر بالموقع
  bedNumber              String?   // رقم السرير المخصص
  phoneEncrypted         String?
  phoneBlindIndex        String?
  emergencyContactName   String?
  emergencyPhoneEncrypted String?
  drivingLicense         String?   // لا توجد رخصة، خاصة، مهنية 1، 2، 3، معدات ثقيلة
  militaryStatus         String?   // أدى الخدمة، إعفاء نهائي، إعفاء مؤقت، إلخ
  maritalStatus          String?   // أعزب، متزوج، متزوج ويعول، إلخ
  previousInsuranceStatus String?  // غير مؤمن، مؤمن سابقاً، متفرغ
  idCardFrontPath        String?   // صورة وجه البطاقة / الجواز
  idCardBackPath         String?   // صورة ظهر البطاقة
  idCardExpiryDate       DateTime? // تاريخ انتهاء سريان البطاقة (مستخرج بالذكاء الاصطناعي من ظهر البطاقة)
  idCardExpiryAlertSentAt DateTime? // تاريخ إرسال إشعار التنبيه قبل الانتهاء بشهر
  address                String?   // محل الإقامة / العنوان المستخرج بالذكاء الاصطناعي أو المسجل يدوياً
  telegramId             BigInt?   @unique
  status                 String    @default("ACTIVE") // ACTIVE, ON_LEAVE, TERMINATED, RESIGNED
  terminationDate        DateTime?
  terminationReason      String?
  isDeleted              Boolean   @default(false)
  deletedAt              DateTime?
  deletedBy              BigInt?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant                 Tenant?                      @relation(fields: [tenantId], references: [id])
  department             Department?                  @relation(fields: [departmentId], references: [id])
  jobRef                 JobTitle?                    @relation(fields: [jobTitleId], references: [id])
  site                   Site?                        @relation(fields: [siteId], references: [id])
  canteenItem            CanteenItem?                 @relation("WorkerCigaretteItem", fields: [canteenItemId], references: [id])
  user                   User?
  salaryHistories        SalaryHistory[]
  changeLogs             WorkerChangeLog[]
  customAllowances       WorkerCustomAllowance[]
  ppeAssets              PPEAsset[]
  disciplinaryAndBonuses DisciplinaryAndBonus[]
  clearance              WorkerClearance?
  delegations            WorkerDelegation[]
  balanceSnapshot        WorkerBalanceSnapshot?
  leaves                 Leave[]
  leaveAllowances        LeaveAllowance[]
  dutyRosters            DutyRoster[]
  assignedTasks          SiteTask[]
  managedCustodies       FinancialCustody[]
  ledgers                FinancialLedger[]
  advanceRequests        AdvanceRequest[]
  advanceInstallments    AdvanceInstallment[]
  accommodations         SiteAccommodationAssignment[]
  payrollRecords         PayrollRecord[]
  mealSurveys            MealSurvey[]
  fuelLogs               FuelDispenseLog[]
  operatedEquipments     Equipment[]
  fuelTanksSupervised    FuelTank[]
  hospitalityDisbursed   HospitalityExpense[]
  kitchenDispenses       KitchenMealDispense[]
  foodShipmentsReceived  FoodInboundShipment[]
  expenseClaims          WorkerExpenseClaim[]
  editRequests           WorkerEditRequest[]
  documents              WorkerDocument[]

  @@index([phoneBlindIndex])
  @@index([status])
  @@index([isDeleted])
  @@index([legacyCode])
  @@index([idCardExpiryDate])
  @@map("workers")
}

model WorkerDocument {
  id             String   @id @default(uuid())
  workerId       String
  title          String   // e.g. "عقد عمل", "شهادة صحية", "فيش وتشبيه", "مؤهل دراسي"
  category       String   @default("OTHER") // NATIONAL_ID, CONTRACT, HEALTH_CERTIFICATE, CRIMINAL_RECORD, DRIVING_LICENSE, EDUCATION, OTHER
  fileName       String
  fileType       String   // "image/jpeg", "application/pdf", etc.
  fileUri        String   // المسار المحلي: attachments/workers/OP-DRV-001/filename.pdf
  driveFileId    String?  // معرف الملف على Google Drive إن وُجد
  fileSizeBytes  BigInt?
  uploadedBy     BigInt?  // Telegram ID لمن قام برفع المستند
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  worker         Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@map("worker_documents")
}

model WorkerEditRequest {
  id                  String    @id @default(uuid())
  requestId           String    @unique // EDT-260907-001
  workerId            String
  workerCode          String
  workerName          String
  requesterTelegramId BigInt
  requesterName       String
  requesterRole       String    // FIELD_ADMIN, WORKER
  fieldKey            String    // legacyCode, phone, walletNumber, jobTitle, siteId, drivingLicense, etc.
  fieldName           String    // اسم الحقل بالعربية
  oldValue            String?
  newValue            String
  reason              String?
  status              String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewedByAdminId   BigInt?
  reviewedAt          DateTime?
  reviewNotes         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  worker              Worker    @relation(fields: [workerId], references: [id])

  @@index([status])
  @@index([workerId])
  @@index([workerCode])
  @@map("worker_edit_requests")
}

model SalaryHistory {
  id                       String    @id @default(uuid())
  changeId                 String    @unique // e.g. SAL-2609-0042
  workerId                 String
  previousBasicSalary      Decimal   @default(0) @db.Decimal(12, 2)
  previousAdditionalSalary Decimal   @default(0) @db.Decimal(12, 2)
  previousGrossSalary      Decimal   @default(0) @db.Decimal(12, 2)
  newBasicSalary           Decimal   @db.Decimal(12, 2)
  newAdditionalSalary      Decimal   @db.Decimal(12, 2)
  newGrossSalary           Decimal   @db.Decimal(12, 2)
  effectiveMonth           String    // YYYY-MM
  effectiveDate            DateTime
  reason                   String    // مبرر الزيادة/التعديل
  approvedByTelegramId     BigInt?
  approvedByName           String?
  notes                    String?
  createdAt                DateTime  @default(now())

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, effectiveDate])
  @@index([effectiveMonth])
  @@map("salary_histories")
}

model WorkerChangeLog {
  id              String   @id @default(uuid())
  changeId        String   @unique // e.g. WCL-260910-001
  workerId        String
  workerCode      String
  category        String   // STRUCTURAL, PERSONAL, CONTACT_PAYOUT, STATUS
  fieldKey        String   // siteId, jobTitle, phone, contractType, status, etc.
  fieldNameAr     String   // "الموقع الميداني", "المسمى الوظيفي", "رقم الهاتف", إلخ
  oldValue        String?  // القيمة السابقة الصريحة
  newValue        String?  // القيمة الجديدة المحدثة
  oldDisplayValue String?  // الاسم المقروء السابق
  newDisplayValue String?  // الاسم المقروء الجديد
  reason          String?  // مبرر التعديل
  actorTelegramId BigInt   // هوية المسؤول المعدل
  actorName       String?  // اسم السوبر أدمن
  actorRole       String   // SUPER_ADMIN
  createdAt       DateTime @default(now())

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, createdAt])
  @@index([category])
  @@index([fieldKey])
  @@map("worker_change_logs")
}

model WorkerCustomAllowance {
  id            String    @id @default(uuid())
  workerId      String
  allowanceType String    // HARDSHIP_ALLOWANCE, RISK_ALLOWANCE, NIGHT_SHIFT, HOUSING_STIPEND
  amount        Decimal   @db.Decimal(12, 2)
  isRecurring   Boolean   @default(true)
  startDate     DateTime
  endDate       DateTime?
  isActive      Boolean   @default(true)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  worker Worker @relation(fields: [workerId], references: [id])

  @@map("worker_custom_allowances")
}

model PPEAsset {
  id                       String    @id @default(uuid())
  voucherId                String    @unique // e.g. #PPE-YYYY-XXX
  workerId                 String
  assetType                String    // SAFETY_HELMET, SAFETY_SHOES, HI_VIS_VEST, SAFETY_GOGGLES, HARNESS
  brandModel               String?
  issueDate                DateTime  @default(now())
  scheduledReplacementDate DateTime?
  costPrice                Decimal   @db.Decimal(10, 2)
  condition                String    @default("NEW") // NEW, GOOD, DAMAGED_NATURAL, LOST_NEGLIGENT
  returnDate               DateTime?
  isDeductedFromWorker     Boolean   @default(false)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  worker Worker @relation(fields: [workerId], references: [id])

  @@map("ppe_assets")
}

model DisciplinaryAndBonus {
  id              String   @id @default(uuid())
  recordNumber    String   @unique // e.g. #DISC-YYYY-XXX or #BON-YYYY-XXX
  workerId        String
  type            String   // BONUS_CASH, BONUS_DAYS, PENALTY_CASH, PENALTY_DAYS
  amount          Decimal? @db.Decimal(12, 2)
  daysEquivalent  Decimal? @db.Decimal(6, 2)
  reason          String
  decisionDate    DateTime @default(now())
  appliedToMonth  String?  // YYYY-MM
  approvedByUserId BigInt?
  createdAt       DateTime @default(now())

  worker Worker @relation(fields: [workerId], references: [id])

  @@map("disciplinary_and_bonuses")
}

model WorkerClearance {
  id                        String    @id @default(uuid())
  clearanceNumber           String    @unique // e.g. #CLR-YYYY-XXX
  workerId                  String    @unique
  terminationDate           DateTime
  serviceDurationDays       Int
  accruedLeaveDays          Decimal   @default(0) @db.Decimal(6, 2)
  endOfServiceGratuity      Decimal   @default(0) @db.Decimal(12, 2)
  totalUnpaidSalaries       Decimal   @default(0) @db.Decimal(12, 2)
  totalOutstandingAdvances  Decimal   @default(0) @db.Decimal(12, 2)
  custodiesReturned         Boolean   @default(true)
  ppeReturned               Boolean   @default(true)
  netSettlementAmount       Decimal   @db.Decimal(12, 2)
  paymentVoucherNumber      String?
  receiptPhotoUri           String?
  sha256Checksum            String?
  status                    String    @default("APPROVED") // DRAFT, AUDITED, APPROVED, EXECUTED
  settledAt                 DateTime  @default(now())
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  worker Worker @relation(fields: [workerId], references: [id])

  @@map("worker_clearances")
}

model WorkerBalanceSnapshot {
  id                       String   @id @default(uuid())
  workerId                 String   @unique
  totalEarnedAllTime       Decimal  @default(0) @db.Decimal(14, 2)
  totalPaidAllTime         Decimal  @default(0) @db.Decimal(14, 2)
  currentMonthAdvances     Decimal  @default(0) @db.Decimal(12, 2)
  outstandingLoansBalance  Decimal  @default(0) @db.Decimal(12, 2)
  lastUpdatedLedgerHash    String?
  updatedAt                DateTime @updatedAt

  worker Worker @relation(fields: [workerId], references: [id])

  @@map("worker_balance_snapshots")
}

// -------------------------------------------------------------
// 3. Leaves & Field Operations
// -------------------------------------------------------------

model Leave {
  id                    String    @id @default(uuid())
  leaveNumber           String    @unique // e.g. #LV-YYYY-XXXX
  workerId              String
  siteId                String
  leaveType             String    @default("ANNUAL") // ANNUAL, CASUAL, MISSION, SICK, UNPAID
  requestDate           DateTime  @default(now())
  departureDate         DateTime
  expectedReturnDate    DateTime
  actualReturnDate      DateTime?
  status                String    @default("PENDING") // PENDING, APPROVED, REJECTED, ACTIVE_ON_LEAVE, RESUMED, OVERDUE
  overdueDays           Int       @default(0)
  penaltyDaysCalculated Decimal   @default(0) @db.Decimal(6, 2)
  deductionAmount       Decimal   @default(0) @db.Decimal(12, 2)
  isOverstayPardoned    Boolean   @default(false)
  overstayPardonReason  String?
  supervisorNotes       String?
  approvedByUserId      BigInt?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  worker     Worker           @relation(fields: [workerId], references: [id])
  site       Site             @relation(fields: [siteId], references: [id])
  allowances LeaveAllowance[]

  @@map("leaves")
}

model LeaveAllowance {
  id                     String            @id @default(uuid())
  leaveId                String
  workerId               String
  travelStipend          Decimal           @db.Decimal(10, 2)
  disbursedFromCustodyId String?
  disbursementDate       DateTime          @default(now())
  voucherNumber          String?
  createdAt              DateTime          @default(now())

  leave   Leave             @relation(fields: [leaveId], references: [id])
  worker  Worker            @relation(fields: [workerId], references: [id])
  custody FinancialCustody? @relation(fields: [disbursedFromCustodyId], references: [id])

  @@map("leave_allowances")
}

model DutyRoster {
  id               String   @id @default(uuid())
  dutyDate         DateTime
  siteId           String
  workerId         String
  equipmentId      String?
  shiftType        String   @default("DAY_SHIFT") // DAY_SHIFT, NIGHT_SHIFT
  hoursWorked      Decimal  @default(10) @db.Decimal(5, 2)
  status           String   @default("PRESENT") // PRESENT, ABSENT_UNEXCUSED, REST_DAY, ON_DUTY_MISSION
  latitude         Decimal? @db.Decimal(10, 7)
  longitude        Decimal? @db.Decimal(10, 7)
  recordedByUserId BigInt?
  createdAt        DateTime @default(now())

  site      Site       @relation(fields: [siteId], references: [id])
  worker    Worker     @relation(fields: [workerId], references: [id])
  equipment Equipment? @relation(fields: [equipmentId], references: [id])

  @@unique([dutyDate, workerId])
  @@map("duty_rosters")
}

model SiteTask {
  id                 String    @id @default(uuid())
  taskNumber         String    @unique // e.g. #TSK-YYYY-XXX
  siteId             String
  title              String
  description        String?
  assignedToWorkerId String?
  priority           String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT_SAFETY
  status             String    @default("OPEN") // OPEN, IN_PROGRESS, COMPLETED, CANCELLED
  dueDate            DateTime?
  completedAt        DateTime?
  attachmentUri      String?
  sha256Checksum     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  site   Site    @relation(fields: [siteId], references: [id])
  worker Worker? @relation(fields: [assignedToWorkerId], references: [id])

  @@map("site_tasks")
}

// -------------------------------------------------------------
// 4. Treasury, Custodies & Site Expenses
// -------------------------------------------------------------

model CompanyTreasury {
  id             String   @id @default(uuid())
  tenantId       String
  name           String
  accountType    String   @default("MAIN_CASH_VAULT") // MAIN_CASH_VAULT, BANK_ACCOUNT, VODAFONE_CASH_WALLET, INSTAPAY_WALLET
  bankName       String?
  accountNumber  String?
  currentBalance Decimal  @default(0) @db.Decimal(14, 2)
  version        Int      @default(1) // Optimistic locking
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant           Tenant             @relation(fields: [tenantId], references: [id])
  fundedCustodies  FinancialCustody[]
  supplierPayments SupplierPayment[]

  @@map("company_treasuries")
}

model FinancialCustody {
  id                          String    @id @default(uuid())
  custodyNumber               String    @unique // e.g. #FC-YYYY-XXX or #EX-YYYY-XXX
  siteId                      String
  custodianWorkerId           String
  initialAmount               Decimal   @db.Decimal(14, 2)
  currentBalance              Decimal   @db.Decimal(14, 2)
  totalLiquidatedExpenses     Decimal   @default(0) @db.Decimal(14, 2)
  totalCashAdvancesDisbursed  Decimal   @default(0) @db.Decimal(14, 2)
  purpose                     String
  status                      String    @default("ACTIVE") // ACTIVE, SETTLEMENT_PENDING, CLOSED
  disbursedAt                 DateTime  @default(now())
  closedAt                    DateTime?
  disbursedFromTreasuryId     String?
  version                     Int       @default(1) // Optimistic locking
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  site                Site                 @relation(fields: [siteId], references: [id])
  custodian           Worker               @relation(fields: [custodianWorkerId], references: [id])
  treasury            CompanyTreasury?     @relation(fields: [disbursedFromTreasuryId], references: [id])
  expenseItems        CustodyExpenseItem[]
  settlements         CustodySettlement[]
  ledgers             FinancialLedger[]
  leaveAllowances     LeaveAllowance[]
  hospitalityExpenses HospitalityExpense[]
  supplierPayments    SupplierPayment[]
  settledExpenseClaims WorkerExpenseClaim[]

  @@map("financial_custodies")
}

model CustodyExpenseItem {
  id              String   @id @default(uuid())
  custodyId       String
  itemSequence    Int
  expenseCategory String
  amount          Decimal  @db.Decimal(12, 2)
  vendorName      String?
  receiptDate     DateTime
  description     String
  receiptImageUri String?
  sha256Checksum  String?
  ocrExtractedData Json?
  isApproved      Boolean  @default(true)
  recordHash      String   @default("") @map("record_hash")
  previousHash    String?  @map("previous_hash")
  hashTimestamp   DateTime @default(now()) @map("hash_timestamp")
  createdAt       DateTime @default(now())

  custody FinancialCustody @relation(fields: [custodyId], references: [id])

  @@index([recordHash])
  @@index([previousHash])
  @@index([hashTimestamp])
  @@map("custody_expense_items")
}

model CustodySettlement {
  id                     String    @id @default(uuid())
  settlementNumber       String    @unique // e.g. #SET-YYYY-XXX
  custodyId              String
  closingTotalInvoices   Decimal   @db.Decimal(14, 2)
  closingTotalAdvances   Decimal   @db.Decimal(14, 2)
  remainingCashReturned  Decimal   @db.Decimal(14, 2)
  settlementDisposition String    @default("REFUND_TO_TREASURY") // REFUND_TO_TREASURY, ROLLOVER_NEW_CUSTODY, DEDUCT_AS_ADVANCE_ON_CUSTODIAN
  settlementSheetPhotoUri String?
  status                 String    @default("PENDING_AUDIT") // PENDING_AUDIT, APPROVED, REJECTED
  auditedByUserId        BigInt?
  settledAt              DateTime?
  recordHash             String    @default("") @map("record_hash")
  previousHash           String?   @map("previous_hash")
  hashTimestamp          DateTime  @default(now()) @map("hash_timestamp")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  custody FinancialCustody @relation(fields: [custodyId], references: [id])

  @@index([recordHash])
  @@index([previousHash])
  @@index([hashTimestamp])
  @@map("custody_settlements")
}

model HospitalityExpense {
  id                 String   @id @default(uuid())
  voucherId          String   @unique // e.g. #HOSP-YYYY-XXX
  siteId             String
  amount             Decimal  @db.Decimal(10, 2)
  guestNameOrEntity  String
  occasion           String
  sourceCustodyId    String?
  disbursedByWorkerId String?
  receiptPhotoUri    String?
  sha256Checksum     String?
  recordHash         String   @default("") @map("record_hash")
  previousHash       String?  @map("previous_hash")
  hashTimestamp      DateTime @default(now()) @map("hash_timestamp")
  createdAt          DateTime @default(now())

  site    Site              @relation(fields: [siteId], references: [id])
  custody FinancialCustody? @relation(fields: [sourceCustodyId], references: [id])
  worker  Worker?           @relation(fields: [disbursedByWorkerId], references: [id])

  @@index([recordHash])
  @@index([previousHash])
  @@index([hashTimestamp])
  @@map("hospitality_expenses")
}

model WorkerExpenseClaim {
  id                              String    @id @default(uuid())
  claimNumber                     String    @unique // e.g. #CLM-YYYY-XXXX
  tenantId                        String
  workerId                        String
  siteId                          String
  amount                          Decimal   @db.Decimal(12, 2)
  expenseCategory                 String    // FUEL, MAINTENANCE, SPARE_PARTS, EMERGENCY_SUPPLIES, HOSPITALITY, OTHER
  description                     String
  receiptImageUri                 String?
  receiptSha256                   String?
  settlementType                  String?   // FIELD_CUSTODY, MAIN_TREASURY, PAYROLL_ACCRUAL
  settlementCustodyId             String?
  settlementTreasuryTransactionId String?
  payrollRecordId                 String?
  status                          String    @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED_PENDING_SETTLEMENT, SETTLED, REJECTED
  rejectionReason                 String?
  approvedByUserId                BigInt?
  settledAt                       DateTime?
  recordHash                      String    @default("") @map("record_hash")
  previousHash                    String?   @map("previous_hash")
  hashTimestamp                   DateTime  @default(now()) @map("hash_timestamp")
  notes                           String?
  createdAt                       DateTime  @default(now())
  updatedAt                       DateTime  @updatedAt

  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  worker            Worker            @relation(fields: [workerId], references: [id])
  site              Site              @relation(fields: [siteId], references: [id])
  settlementCustody FinancialCustody? @relation(fields: [settlementCustodyId], references: [id])
  payrollRecord     PayrollRecord?    @relation(fields: [payrollRecordId], references: [id])

  @@index([workerId])
  @@index([siteId])
  @@index([status])
  @@index([settlementType])
  @@index([recordHash])
  @@index([previousHash])
  @@index([hashTimestamp])
  @@map("worker_expense_claims")
}


// -------------------------------------------------------------
// 5. Closed-Loop Cryptographic Financial Ledger (SHA-256 Chained)
// -------------------------------------------------------------

model AdvanceRequest {
  id                String   @id @default(uuid())
  requestNumber     String   @unique // e.g. #ARQ-YYYY-XXXX
  workerId          String
  amountRequested   Decimal  @db.Decimal(12, 2)
  purpose           String
  installmentMonths Int      @default(1)
  status            String   @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectionReason   String?
  approvedAmount    Decimal? @db.Decimal(12, 2)
  approvedByUserId  BigInt?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  worker Worker @relation(fields: [workerId], references: [id])

  @@map("advance_requests")
}

model FinancialLedger {
  id                 String    @id @default(uuid())
  voucherNumber      String    @unique // e.g. #ADV-YYYY-XXXX, #PAY-YYYY-XXXX
  recordHash          String    @default("") @map("record_hash")
  previousHash        String?   @map("previous_hash")
  hashTimestamp       DateTime  @default(now()) @map("hash_timestamp")
  transactionType     String    // ADVANCE_CASH, WITHDRAWAL_CIGARETTES, WITHDRAWAL_PURCHASES, SALARY_PAYOUT, SUPPLIER_PAYMENT, CUSTODY_DISBURSEMENT, CUSTODY_REFUND, GENERAL_EXPENSE
  amount              Decimal   @db.Decimal(14, 2)
  currency            String    @default("EGP")
  sourceAccount       String
  destinationAccount  String
  sourceCustodyId     String?   // Populated for cash advances disbursed from a site custody
  workerId            String?
  supplierId          String?
  canteenItemId       String?
  inKindDetails       Json?     // In-kind purchase/cigarette item breakdown
  description         String?
  accountingMonth     String?   // YYYY-MM
  isReversal          Boolean   @default(false)
  reversalOfVoucherId String?
  actorTelegramId     BigInt
  receiptPhotoUri     String?
  sha256Checksum      String?
  isDeleted           Boolean   @default(false)
  deletedAt           DateTime?
  deletedBy           BigInt?
  deletionReason      String?
  createdAt           DateTime  @default(now())
  syncedToSheets      Boolean   @default(false)
  syncedAt            DateTime?

  worker        Worker?             @relation(fields: [workerId], references: [id])
  sourceCustody FinancialCustody?   @relation(fields: [sourceCustodyId], references: [id])
  supplier      Supplier?           @relation(fields: [supplierId], references: [id])
  canteenItem   CanteenItem?        @relation(fields: [canteenItemId], references: [id])
  installments  AdvanceInstallment[]

  @@index([transactionType])
  @@index([sourceAccount])
  @@index([sourceCustodyId])
  @@index([destinationAccount])
  @@index([syncedToSheets])
  @@index([recordHash])
  @@index([previousHash])
  @@index([hashTimestamp])
  @@map("financial_ledgers")
}

model AdvanceInstallment {
  id                    String      @id @default(uuid())
  workerId              String
  originalVoucherNumber String
  installmentSequence   Int
  dueMonth              String      // YYYY-MM
  installmentAmount     Decimal     @db.Decimal(12, 2)
  status                String      @default("PENDING") // PENDING, DEDUCTED_FROM_PAYROLL, WAIVED_BY_ADMIN
  deductedInPayrollRunId String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  worker     Worker          @relation(fields: [workerId], references: [id])
  ledger     FinancialLedger @relation(fields: [originalVoucherNumber], references: [voucherNumber])
  payrollRun PayrollRun?     @relation(fields: [deductedInPayrollRunId], references: [id])

  @@map("advance_installments")
}

// -------------------------------------------------------------
// 6. Suppliers, Procurement & Work Orders
// -------------------------------------------------------------

model Supplier {
  id             String   @id @default(uuid())
  tenantId       String
  code           String   @unique // e.g. #VND-XXX or #EX-VND-XXX
  name           String
  category       String   // WORKSHOPS_MACHINING, SPARE_PARTS, FOOD_CATERING, FUEL_OILS, EQUIPMENT_RENTAL, GENERAL_SUPPLIES
  phoneEncrypted String?
  phoneBlindIndex String?
  taxNumber      String?
  openingBalance Decimal  @default(0) @db.Decimal(14, 2)
  totalInvoiced  Decimal  @default(0) @db.Decimal(14, 2)
  totalPaid      Decimal  @default(0) @db.Decimal(14, 2)
  currentBalance Decimal  @default(0) @db.Decimal(14, 2)
  scope          String   @default("FIELD") // FIELD, EXECUTIVE
  siteId         String?
  telegramId     BigInt?  @unique
  status         String   @default("ACTIVE") // ACTIVE, SUSPENDED
  version        Int      @default(1) // Optimistic locking
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant        Tenant                 @relation(fields: [tenantId], references: [id])
  user          User?
  invoices      SupplierInvoice[]
  payments      SupplierPayment[]
  foodShipments FoodInboundShipment[]
  maintenances  EquipmentMaintenance[]
  ledgers       FinancialLedger[]

  @@index([phoneBlindIndex])
  @@map("suppliers")
}

model SupplierInvoice {
  id               String   @id @default(uuid())
  invoiceNumber    String   @unique // e.g. #WO-YYYY-XXXX
  supplierId       String
  siteId           String
  equipmentId      String?
  invoiceDate      DateTime
  subtotalAmount   Decimal  @db.Decimal(14, 2)
  taxAmount        Decimal  @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal  @db.Decimal(14, 2)
  paidAmount       Decimal  @default(0) @db.Decimal(14, 2)
  remainingBalance Decimal  @db.Decimal(14, 2)
  paymentStatus    String   @default("UNPAID") // UNPAID, PARTIALLY_PAID, PAID_FULL
  description      String?
  invoicePhotoUri  String?
  sha256Checksum   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  supplier           Supplier              @relation(fields: [supplierId], references: [id])
  site               Site                  @relation(fields: [siteId], references: [id])
  equipment          Equipment?            @relation(fields: [equipmentId], references: [id])
  items              SupplierInvoiceItem[]
  payments           SupplierPayment[]
  sparePartsRequests SparePartsRequest[]

  @@map("supplier_invoices")
}

model SupplierInvoiceItem {
  id              String   @id @default(uuid())
  invoiceId       String
  itemSequence    Int
  itemDescription String
  quantity        Decimal  @db.Decimal(10, 2)
  unit            String   @default("UNIT")
  unitPrice       Decimal  @db.Decimal(12, 2)
  totalPrice      Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  invoice SupplierInvoice @relation(fields: [invoiceId], references: [id])

  @@map("supplier_invoice_items")
}

model SupplierPayment {
  id                     String    @id @default(uuid())
  paymentNumber          String    @unique // e.g. #SPAY-YYYY-XXXX
  supplierId             String
  invoiceId              String?
  amount                 Decimal   @db.Decimal(14, 2)
  paymentMethod          String    @default("CASH_CUSTODY") // CASH_CUSTODY, BANK_TRANSFER, CHEQUE, TREASURY_CASH
  disbursedFromTreasuryId String?
  disbursedFromCustodyId String?
  transactionReference   String?
  receiptPhotoUri        String?
  sha256Checksum         String?
  recordHash             String    @default("") @map("record_hash")
  previousHash           String?   @map("previous_hash")
  hashTimestamp          DateTime  @default(now()) @map("hash_timestamp")
  paymentDate            DateTime  @default(now())
  createdAt              DateTime  @default(now())

  supplier  Supplier          @relation(fields: [supplierId], references: [id])
  invoice   SupplierInvoice?  @relation(fields: [invoiceId], references: [id])
  treasury  CompanyTreasury?  @relation(fields: [disbursedFromTreasuryId], references: [id])
  custody   FinancialCustody? @relation(fields: [disbursedFromCustodyId], references: [id])

  @@index([recordHash])
  @@index([previousHash])
  @@index([hashTimestamp])
  @@map("supplier_payments")
}

// -------------------------------------------------------------
// 7. Fleet, Equipment & Fuel Management
// -------------------------------------------------------------

model Equipment {
  id                             String    @id @default(uuid())
  tenantId                       String
  code                           String    @unique // e.g. EQ-01
  name                           String
  type                           String    // LOADER, EXCAVATOR, DUMP_TRUCK, BULLDOZER, GENERATOR, WATER_TANKER, PICKUP_TRUCK
  brand                          String?
  modelYear                      Int?
  plateNumber                    String?
  chassisNumber                  String?
  siteId                         String
  assignedWorkerId               String?
  meterType                      String    @default("HOURS") // HOURS, KILOMETERS
  currentMeterReading            Decimal   @default(0) @db.Decimal(10, 2)
  currentFuelLevelPercentage     Decimal?  @db.Decimal(5, 2)
  technicalStatus                String    @default("OPERATIONAL") // OPERATIONAL, NEEDS_MAINTENANCE, BROKEN_DOWN_STOPPED
  lastMaintenanceDate            DateTime?
  nextScheduledMaintenanceMeter  Decimal?  @db.Decimal(10, 2)
  createdAt                      DateTime  @default(now())
  updatedAt                      DateTime  @updatedAt

  tenant             Tenant                 @relation(fields: [tenantId], references: [id])
  site               Site                   @relation(fields: [siteId], references: [id])
  assignedWorker     Worker?                @relation(fields: [assignedWorkerId], references: [id])
  dutyRosters        DutyRoster[]
  fuelLogs           FuelDispenseLog[]
  maintenances       EquipmentMaintenance[]
  sparePartsRequests SparePartsRequest[]
  supplierInvoices   SupplierInvoice[]

  @@map("equipments")
}

model FuelTank {
  id                       String   @id @default(uuid())
  siteId                   String
  code                     String   @unique // e.g. TNK-01
  name                     String
  fuelType                 String   @default("DIESEL_SOLAR") // DIESEL_SOLAR, GASOLINE_80, GASOLINE_92
  totalCapacityLiters      Decimal  @db.Decimal(10, 2)
  currentStockLiters       Decimal  @db.Decimal(10, 2)
  minSafetyThresholdLiters Decimal  @db.Decimal(10, 2)
  supervisorWorkerId       String?
  status                   String   @default("ACTIVE") // ACTIVE, MAINTENANCE, DECOMMISSIONED
  version                  Int      @default(1) // Optimistic locking
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  site         Site              @relation(fields: [siteId], references: [id])
  supervisor   Worker?           @relation(fields: [supervisorWorkerId], references: [id])
  dispenseLogs FuelDispenseLog[]

  @@map("fuel_tanks")
}

model FuelDispenseLog {
  id                     String   @id @default(uuid())
  dispenseNumber         String   @unique // e.g. #FL-YYYY-XXXX
  tankId                 String
  equipmentId            String
  operatorWorkerId       String
  litersDispensed        Decimal  @db.Decimal(10, 2)
  meterReadingAtDispense Decimal  @db.Decimal(10, 2)
  unitCostPerLiter       Decimal  @db.Decimal(8, 2)
  totalCost              Decimal  @db.Decimal(12, 2)
  latitude               Decimal? @db.Decimal(10, 7)
  longitude              Decimal? @db.Decimal(10, 7)
  dispensedByUserId      BigInt?
  timestamp              DateTime @default(now())
  createdAt              DateTime @default(now())

  tank      FuelTank  @relation(fields: [tankId], references: [id])
  equipment Equipment @relation(fields: [equipmentId], references: [id])
  operator  Worker    @relation(fields: [operatorWorkerId], references: [id])

  @@map("fuel_dispense_logs")
}

model EquipmentMaintenance {
  id                  String    @id @default(uuid())
  maintenanceNumber   String    @unique // e.g. #MNT-YYYY-XXXX
  equipmentId         String
  maintenanceType     String    // OIL_AND_FILTER_CHANGE, HYDRAULIC_SYSTEM, TIRES_AND_TRACKS, ENGINE_OVERHAUL, ELECTRICAL_SYSTEM, PREVENTIVE_PERIODIC
  meterReading        Decimal   @db.Decimal(10, 2)
  supplierId          String?
  totalCost           Decimal   @db.Decimal(12, 2)
  description         String
  nextDueMeterReading Decimal?  @db.Decimal(10, 2)
  performedAt         DateTime  @default(now())
  approvedByUserId    BigInt?
  createdAt           DateTime  @default(now())

  equipment Equipment @relation(fields: [equipmentId], references: [id])
  supplier  Supplier? @relation(fields: [supplierId], references: [id])

  @@map("equipment_maintenances")
}

model SparePartsRequest {
  id            String    @id @default(uuid())
  requestNumber String    @unique // e.g. #SPR-YYYY-XXX
  equipmentId   String
  partName      String
  quantity      Int       @default(1)
  urgency       String    @default("ROUTINE") // ROUTINE, URGENT_MACHINE_DOWN
  estimatedCost Decimal?  @db.Decimal(12, 2)
  status        String    @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, PURCHASED, INSTALLED_ON_MACHINE, REJECTED
  invoiceId     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  equipment Equipment        @relation(fields: [equipmentId], references: [id])
  invoice   SupplierInvoice? @relation(fields: [invoiceId], references: [id])

  @@map("spare_parts_requests")
}

// -------------------------------------------------------------
// 8. Camp, Catering & Canteen
// -------------------------------------------------------------

model CanteenItem {
  id               String   @id @default(uuid())
  siteId           String
  code             String   @unique // e.g. CAN-CIG-01
  name             String
  category         String   // CIGARETTES, SNACKS_AND_FOOD, BEVERAGES, PERSONAL_CARE
  costPrice        Decimal  @db.Decimal(10, 2)
  sellingPrice     Decimal  @db.Decimal(10, 2)
  currentStock     Decimal  @default(0) @db.Decimal(10, 2)
  reorderThreshold Decimal  @default(5) @db.Decimal(10, 2)
  isActive         Boolean  @default(true)
  version          Int      @default(1) // Optimistic locking
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  site    Site              @relation(fields: [siteId], references: [id])
  ledgers FinancialLedger[]
  workers Worker[]          @relation("WorkerCigaretteItem")

  @@map("canteen_items")
}

model CampFoodItem {
  id                   String   @id @default(uuid())
  siteId               String
  code                 String   @unique // e.g. FOD-RICE
  name                 String
  unit                 String   @default("KG") // KG, LITER, CARTON, BAG
  currentStock         Decimal  @default(0) @db.Decimal(10, 2)
  weightedAverageCost  Decimal  @default(0) @db.Decimal(10, 2)
  reorderThreshold     Decimal  @default(20) @db.Decimal(10, 2)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  site Site @relation(fields: [siteId], references: [id])

  @@map("camp_food_items")
}

model FoodInboundShipment {
  id                       String   @id @default(uuid())
  shipmentNumber           String   @unique // e.g. #FSH-YYYY-XXX
  siteId                   String
  supplierId               String
  deliveryDate             DateTime @default(now())
  totalInvoiceAmount       Decimal  @db.Decimal(12, 2)
  qualityInspectionStatus  String   @default("ACCEPTED_FULL") // ACCEPTED_FULL, PARTIAL_REJECTION, REJECTED
  receivedByWorkerId       String?
  createdAt                DateTime @default(now())

  site       Site     @relation(fields: [siteId], references: [id])
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  receivedBy Worker?  @relation(fields: [receivedByWorkerId], references: [id])

  @@map("food_inbound_shipments")
}

model Recipe {
  id                  String   @id @default(uuid())
  name                String
  mealCategory        String   // BREAKFAST, LUNCH, DINNER, NIGHT_SHIFT_MEAL
  standardPortionGrams Int     @default(400)
  ingredientsBreakdown Json
  targetCostPerMeal   Decimal  @db.Decimal(8, 2)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  dispenses KitchenMealDispense[]

  @@map("recipes")
}

model KitchenMealDispense {
  id                   String   @id @default(uuid())
  dispenseDate         DateTime
  siteId               String
  recipeId             String
  mealType             String   // BREAKFAST, LUNCH, DINNER
  servingsCount        Int
  totalIngredientsCost Decimal  @db.Decimal(12, 2)
  actualCostPerServing Decimal  @db.Decimal(8, 2)
  chefWorkerId         String?
  createdAt            DateTime @default(now())

  site   Site    @relation(fields: [siteId], references: [id])
  recipe Recipe  @relation(fields: [recipeId], references: [id])
  chef   Worker? @relation(fields: [chefWorkerId], references: [id])

  @@map("kitchen_meal_dispenses")
}

model FoodWasteLog {
  id                String   @id @default(uuid())
  siteId            String
  logDate           DateTime @default(now())
  foodItemCode      String
  wasteQuantityKg   Decimal  @db.Decimal(8, 2)
  wasteReason       String   // EXPIRED_SPOILAGE, PREPARATION_WASTE, LEFTOVER_DISPOSAL, STORAGE_FAILURE
  estimatedLossCost Decimal  @db.Decimal(10, 2)
  supervisorNotes   String?
  createdAt         DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id])

  @@map("food_waste_logs")
}

model MealSurvey {
  id         String   @id @default(uuid())
  siteId     String
  workerId   String
  surveyDate DateTime @default(now())
  rating     Int      // 1 to 5
  comment    String?
  createdAt  DateTime @default(now())

  site   Site   @relation(fields: [siteId], references: [id])
  worker Worker @relation(fields: [workerId], references: [id])

  @@map("meal_surveys")
}

model MarketPriceBenchmark {
  id             String   @id @default(uuid())
  itemName       String
  unit           String
  benchmarkPrice Decimal  @db.Decimal(10, 2)
  surveyDate     DateTime @default(now())
  createdAt      DateTime @default(now())

  @@map("market_price_benchmarks")
}

// -------------------------------------------------------------
// 9. Phosphate Operations & Commercial Extracts
// -------------------------------------------------------------

model PhosphateProductionSlip {
  id               String   @id @default(uuid())
  slipNumber       String   @unique // e.g. #SLP-YYYY-XXXX
  siteId           String
  truckPlateNumber String
  driverName       String
  transportCompany String?
  oreGrade         String   @default("GRADE_A_CONCENTRATE") // GRADE_A_CONCENTRATE, GRADE_B, RUN_OF_MINE
  grossWeightTons  Decimal  @db.Decimal(10, 3)
  tareWeightTons   Decimal  @db.Decimal(10, 3)
  netWeightTons    Decimal  @db.Decimal(10, 3)
  destination      String?
  slipPhotoUri     String?
  sha256Checksum   String?
  loadingTimestamp DateTime @default(now())
  recordedByUserId BigInt?
  createdAt        DateTime @default(now())

  site Site @relation(fields: [siteId], references: [id])

  @@map("phosphate_production_slips")
}

model PhosphateExtract {
  id                      String    @id @default(uuid())
  extractNumber           String    @unique // e.g. #EXT-YYYY-XXX
  projectId               String
  clientEntityName        String
  periodStartDate         DateTime
  periodEndDate           DateTime
  totalTonnageDelivered   Decimal   @db.Decimal(12, 3)
  contractRatePerTon      Decimal   @db.Decimal(10, 2)
  grossExtractValue       Decimal   @db.Decimal(14, 2)
  deductionsAndRetentions Decimal   @default(0) @db.Decimal(12, 2)
  netPayableAmount        Decimal   @db.Decimal(14, 2)
  paymentStatus           String    @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, APPROVED_BY_CLIENT, COLLECTED_FULL
  collectionDate          DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id])

  @@map("phosphate_extracts")
}

// -------------------------------------------------------------
// 10. Payroll & Financial Settlements
// -------------------------------------------------------------

model PayrollRun {
  id                      String    @id @default(uuid())
  tenantId                String
  runNumber               String    @unique // e.g. #PAYROLL-YYYY-MM
  year                    Int
  month                   Int
  siteId                  String?
  totalContractedPayroll  Decimal   @default(0) @db.Decimal(14, 2)
  totalGrossEarnings      Decimal   @default(0) @db.Decimal(14, 2)
  totalDeductions         Decimal   @default(0) @db.Decimal(14, 2)
  totalNetSalariesPayable Decimal   @default(0) @db.Decimal(14, 2)
  status                  String    @default("DRAFT_CALCULATING") // DRAFT_CALCULATING, AUDITED_BY_HR, APPROVED_BY_EXECUTIVE, DISBURSED_CLOSED
  approvedByUserId        BigInt?
  disbursedAt             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  tenant               Tenant               @relation(fields: [tenantId], references: [id])
  records              PayrollRecord[]
  deductedInstallments AdvanceInstallment[]

  @@unique([tenantId, year, month, siteId])
  @@map("payroll_runs")
}

model PayrollRecord {
  id                           String    @id @default(uuid())
  payrollRunId                 String
  workerId                     String
  daysWorked                   Decimal   @db.Decimal(5, 2)
  daysAbsent                   Decimal   @default(0) @db.Decimal(5, 2)
  daysOnLeave                  Decimal   @default(0) @db.Decimal(5, 2)
  baseDailyWage                Decimal   @db.Decimal(12, 2)
  earnedBasicSalary            Decimal   @db.Decimal(12, 2)
  overtimeAmount               Decimal   @default(0) @db.Decimal(12, 2)
  bonusesAmount                Decimal   @default(0) @db.Decimal(12, 2)
  customAllowancesAmount       Decimal   @default(0) @db.Decimal(12, 2)
  reimbursementsAmount         Decimal   @default(0) @db.Decimal(12, 2)
  grossEarnings                Decimal   @db.Decimal(14, 2)
  cashAdvancesDeduction        Decimal   @default(0) @db.Decimal(12, 2)
  cigaretteWithdrawalsDeduction Decimal  @default(0) @db.Decimal(12, 2)
  purchaseWithdrawalsDeduction Decimal   @default(0) @db.Decimal(12, 2)
  penaltiesDeduction           Decimal   @default(0) @db.Decimal(12, 2)
  loanInstallmentDeduction     Decimal   @default(0) @db.Decimal(12, 2)
  otherDeductions              Decimal   @default(0) @db.Decimal(12, 2)
  totalDeductions              Decimal   @db.Decimal(14, 2)
  netSalaryPayable             Decimal   @db.Decimal(14, 2)
  paymentStatus                String    @default("PENDING") // PENDING, DISBURSED, HELD_DISPUTED
  payoutMethod                 String    @default("CASH_ENVELOPE") // CASH_ENVELOPE, VODAFONE_CASH, INSTAPAY, BANK_DEPOSIT
  payoutReference              String?
  disbursedAt                  DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  payrollRun            PayrollRun           @relation(fields: [payrollRunId], references: [id])
  worker                Worker               @relation(fields: [workerId], references: [id])
  settledExpenseClaims  WorkerExpenseClaim[]

  @@unique([payrollRunId, workerId])
  @@map("payroll_records")
}

// -------------------------------------------------------------
// 11. RBAC, Identity, Audit, APM & Drafts
// -------------------------------------------------------------

model User {
  id                     String    @id @default(uuid())
  tenantId               String?
  telegramId             BigInt    @unique
  username               String?
  fullName               String
  role                   String    // SUPER_ADMIN, EXECUTIVE, FIELD_ADMIN, ACCOUNTANT, SITE_ENGINEER, WORKER, SUPPLIER, GUEST
  workerId               String?   @unique
  supplierId             String?   @unique
  assignedSiteId         String?
  phoneEncrypted         String?
  phoneBlindIndex        String?
  isActive               Boolean   @default(true)
  isBanned               Boolean   @default(false)
  approvedBySuperAdminId BigInt?
  isDeleted              Boolean   @default(false)
  deletedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant        Tenant?             @relation(fields: [tenantId], references: [id])
  worker        Worker?             @relation(fields: [workerId], references: [id])
  supplier      Supplier?           @relation(fields: [supplierId], references: [id])
  assignedSite      Site?               @relation(fields: [assignedSiteId], references: [id])
  notifications     NotificationQueue[]
  dashboardSessions DashboardSession[]
  workerDelegations WorkerDelegation[]

  @@index([phoneBlindIndex])
  @@index([role])
  @@map("users")
}

model BotMenuPermission {
  id           String   @id @default(uuid())
  role         String
  featureKey   String
  isEnabled    Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([role, featureKey])
  @@map("bot_menu_permissions")
}

model AuditLog {
  id              String   @id @default(uuid())
  traceId         String?  @db.VarChar(36)
  actorTelegramId BigInt
  action          String
  entityType      String
  entityId        String
  beforePayload   Json?
  afterPayload    Json?
  ipAddress       String?
  timestamp       DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorTelegramId, timestamp])
  @@map("audit_logs")
}

model BotPerformanceLog {
  id                      String   @id @default(uuid())
  actorTelegramId         BigInt
  callbackQueryOrCommand  String
  executionTimeMs         Int
  dbQueryCount            Int      @default(0)
  performanceTier         String   @default("GREEN_FAST") // GREEN_FAST, YELLOW_ACCEPTABLE, RED_SLOW
  memoryUsageMb           Decimal? @db.Decimal(8, 2)
  errorMessage            String?
  timestamp               DateTime @default(now())

  @@index([performanceTier, timestamp])
  @@map("bot_performance_logs")
}

model ApprovalTicket {
  id                    String    @id @default(uuid())
  ticketNumber          String    @unique // e.g. #TCK-YYYY-XXXX
  ticketType            String    // LEAVE_REQUEST, ADVANCE_REQUEST, TRANSACTION_MODIFICATION, WORKER_EDIT, PPE_REPLACEMENT, SPARE_PARTS_PURCHASE, CUSTODY_LIQUIDATION, END_OF_SERVICE_CLEARANCE
  entityId              String
  requestedByTelegramId BigInt
  status                String    @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewDecisionNotes   String?
  reviewedByTelegramId  BigInt?
  reviewedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status, ticketType])
  @@map("approval_tickets")
}

model UserWizardDraft {
  id          String   @id @default(uuid())
  telegramId  BigInt   @unique
  wizardName  String
  currentStep String
  draftData   Json
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt

  @@map("user_wizard_drafts")
}

model NotificationQueue {
  id                  String    @id @default(uuid())
  recipientTelegramId BigInt
  userId              String?
  priority            String    @default("GENERAL_ALERT") // CRITICAL_SECURITY, FINANCIAL_RECEIPT, GENERAL_ALERT
  messageText         String
  inlineKeyboard      Json?
  status              String    @default("PENDING") // PENDING, DISPATCHING, DELIVERED, FAILED_RETRYING, EXHAUSTED
  retryCount          Int       @default(0)
  scheduledFor        DateTime  @default(now())
  deliveredAt         DateTime?
  errorMessage        String?
  createdAt           DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([status, scheduledFor, priority])
  @@map("notification_dispatch_queues")
}

// -------------------------------------------------------------
// 12. Transactional Outbox (Reliable Hybrid Sync)
// -------------------------------------------------------------

model OutboxEvent {
  id           String    @id @default(uuid())
  eventType    String
  aggregateId  String?
  payload      Json
  status       String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED_RETRY
  retryCount   Int       @default(0)
  errorMessage String?
  createdAt    DateTime  @default(now())
  processedAt  DateTime?

  @@index([status, createdAt])
  @@map("outbox_events")
}

// -------------------------------------------------------------
// 13. System Error Logs & Incident Tracking (Enterprise Crash Vault)
// -------------------------------------------------------------

model SystemErrorLog {
  id              String    @id @default(uuid())
  traceId         String?   @db.VarChar(36)
  service         String    @default("bot-server")
  errorReference  String    @unique // e.g. ERR-7A3F
  errorHash       String
  occurrenceCount Int       @default(1)
  actorTelegramId BigInt?
  actorRole       String?
  actionTrigger   String?   // Command or CallbackData e.g. menu:domain:hr
  sourceLocation  String?   // Module / Handler / Function
  errorMessage    String
  stackTrace      String?
  breadcrumbs     Json?     // Array of last 5 user interaction steps
  severity        String    @default("ERROR") // WARNING, ERROR, CRITICAL, FATAL
  isResolved      Boolean   @default(false)
  resolvedAt      DateTime?
  resolvedById    BigInt?
  createdAt       DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())

  @@index([severity, createdAt])
  @@index([errorHash, isResolved])
  @@index([actorTelegramId, createdAt])
  @@map("system_error_logs")
}

// -------------------------------------------------------------
// 14. Dashboard Authentication, Sessions & RBAC Delegations
// -------------------------------------------------------------

model DashboardAuthLink {
  id              String    @id @default(uuid())
  groupId         String    @db.VarChar(64)
  originKind      String    @default("LOCAL") @db.VarChar(20) // LOCAL, TUNNEL
  targetOrigin    String    @db.VarChar(255) // Full normalized origin e.g. http://localhost:3002
  jtiHash         String    @unique @db.VarChar(64)
  actorTelegramId BigInt
  expiresAt       DateTime
  claimedAt       DateTime?
  claimTraceId    String?   @db.VarChar(36)
  createdAt       DateTime  @default(now())

  @@unique([groupId, originKind])
  @@index([groupId, claimedAt])
  @@index([expiresAt])
  @@index([actorTelegramId])
  @@map("dashboard_auth_links")
}

model DashboardSession {
  id                 String    @id @default(uuid())
  sessionHash        String    @unique @db.VarChar(64)
  userId             String
  actorTelegramId    BigInt
  originKind         String    @default("LOCAL") // LOCAL, TUNNEL
  deviceSummary      String?   @db.VarChar(255)
  userAgentHash      String?   @db.VarChar(64)
  lastSeenAt         DateTime  @default(now())
  expiresAt          DateTime
  maxExpiresAt       DateTime
  extensionCount     Int       @default(0)
  extendedAt         DateTime?
  noticeSentAt       DateTime?
  revokedAt          DateTime?
  revocationReason   String?   @db.VarChar(100)
  permissionsVersion Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([actorTelegramId])
  @@index([expiresAt])
  @@map("dashboard_sessions")
}

model WorkerDelegation {
  id                    String    @id @default(uuid())
  userId                String
  workerId              String
  permissionKey         String    @db.VarChar(100)
  siteId                String
  resourceId            String?
  startsAt              DateTime  @default(now())
  endsAt                DateTime?
  status                String    @default("ACTIVE") // ACTIVE, REVOKED, EXPIRED
  requestedByTelegramId BigInt
  approvedByTelegramId  BigInt
  revokedByTelegramId   BigInt?
  reason                String?   @db.VarChar(255)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@index([workerId, status])
  @@index([siteId, status])
  @@index([permissionKey])
  @@map("worker_delegations")
}
