{
  "name": "@alsaada/database",
  "version": "2.0.0-alpha.86",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc && node -e \"const fs = require('fs'); fs.cpSync('src/generated', 'dist/generated', {recursive: true});\"",
    "test": "vitest run",
    "db:format": "prisma format",
    "db:compose": "tsx ../../tools/modules/compose-database.ts",
    "db:generate": "tsx ../../tools/modules/compose-database.ts && prisma generate && node -e \"const fs = require('fs'); fs.writeFileSync('src/generated/client/index.ts', 'export * from \\\"./client.js\\\";\\nexport { Prisma } from \\\"./client.js\\\";\\n');\"",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio --port 5555 --browser none --hostname 0.0.0.0",
    "db:purge:test": "tsx src/scripts/purge-test-data.ts --confirm",
    "db:seed:company": "tsx src/scripts/seed-company-profile.ts",
    "db:remediate": "tsx src/scripts/remediate-job-matrix-and-cycles.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/pg": "^8.11.11",
    "dotenv": "^16.4.7",
    "prisma": "7.10.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.8"
  }
}
