{
  "name": "@alsaada/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc && node -e \"const fs = require('fs'); fs.cpSync('src/generated', 'dist/generated', {recursive: true});\"",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio --port 5555 --browser none --hostname 0.0.0.0",
    "db:purge:test": "tsx src/scripts/purge-test-data.ts --confirm",
    "db:seed:company": "tsx src/scripts/seed-company-profile.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "prisma": "^6.4.1",
    "typescript": "^5.9.3",
    "vitest": "^3.0.8"
  }
}
