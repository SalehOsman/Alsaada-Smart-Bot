#!/usr/bin/env sh
# Al-Saada Smart Bot Enterprise — Pre-Commit Governance Guard

# ==============================================================================
# 0. صمام الحماية السيادي: حظر الـ Commit المباشر على main (Main Branch Immunity)
# ==============================================================================
CURRENT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --abbrev-ref HEAD 2>/dev/null)

if [ "$CURRENT_BRANCH" = "main" ]; then
  MERGE_HEAD_FILE=$(git rev-parse --git-path MERGE_HEAD 2>/dev/null)
  if [ -z "$MERGE_HEAD_FILE" ] || [ ! -f "$MERGE_HEAD_FILE" ]; then
    echo ""
    echo "🛑 [GOVERNANCE ERROR] يُحظر تماماً ارتكاب أي Commit مباشر على فرع 'main'."
    echo "📌 منهجية العمل تلزم بإنشاء فرع منفصل لكل مهمة (مثال: git checkout -b feat/<name>)."
    echo "🔒 لا يُدمج الفرع إلى main إلا بعد الاختبار الكامل وبإذن صريح ومطابق حرفياً: «ادمج الفرع»."
    echo ""
    exit 1
  fi
fi

# ==============================================================================
# 0.1. حماية من تلف ملفات الاختبار (Redirect Poisoning Guard)
# ==============================================================================
FORBIDDEN_PATTERN='^\{"numTotalTestSuites'
for f in $(git diff --cached --name-only --diff-filter=ACM); do
  if [ -f "$f" ] && echo "$f" | grep -Eq '\.(spec|test)\.[jt]sx?$'; then
    if grep -Eq "$FORBIDDEN_PATTERN" "$f" 2>/dev/null; then
      echo "❌ [PRE-COMMIT ERROR] ملف اختبار مُتلف باسم $f — يحتوي مخرجات vitest JSON"
      exit 1
    fi
  fi
done

echo "🔍 [PRE-COMMIT] Running strict TypeScript, contracts, and architecture checks..."

pnpm typecheck || {
  echo "❌ [PRE-COMMIT ERROR] Typecheck failed. Fix TypeScript errors before committing."
  exit 1
}

pnpm arch:verify || {
  echo "❌ [PRE-COMMIT ERROR] Architecture verification failed. Check handler line counts and required files."
  exit 1
}

pnpm migration:verify || {
  echo "❌ [PRE-COMMIT ERROR] Migration registry verification failed. Check docs/19 parity."
  exit 1
}

pnpm flow-contracts:verify || {
  echo "❌ [PRE-COMMIT ERROR] Flow contracts verification failed."
  exit 1
}

pnpm telegram-contracts:verify || {
  echo "❌ [PRE-COMMIT ERROR] Telegram contracts violated. Check URL/Callback byte limits."
  exit 1
}

pnpm latency:verify || {
  echo "❌ [PRE-COMMIT ERROR] Latency anti-patterns detected. Blocking deleteMessage or awaited setMyCommands found."
  exit 1
}

pnpm rbac-matrix:verify || {
  echo "❌ [PRE-COMMIT ERROR] RBAC matrix verification failed. Deprecated roles or illegal permissions found."
  exit 1
}

pnpm field-masking:verify || {
  echo "❌ [PRE-COMMIT ERROR] Field masking verification failed. Unmasked salary/compensation fields detected."
  exit 1
}

pnpm observability:verify || {
  echo "❌ [PRE-COMMIT ERROR] Observability verification failed. console.error or empty catch blocks found."
  exit 1
}

pnpm test-authenticity:verify || {
  echo "❌ [PRE-COMMIT ERROR] Test authenticity check failed. Sham assertions found."
  exit 1
}

pnpm legacy-parity:verify || {
  echo "❌ [PRE-COMMIT ERROR] Legacy parity verification failed. Accounting invariants violated."
  exit 1
}

pnpm financial:verify || {
  echo "❌ [PRE-COMMIT ERROR] Financial integrity verification failed."
  exit 1
}

pnpm governance:tamper-check || {
  echo "❌ [PRE-COMMIT ERROR] Governance tamper check failed. Locked flow or dashboard feature modified without explicit unlock."
  exit 1
}

pnpm test:pre-commit || {
  echo "❌ [PRE-COMMIT ERROR] Smart test guard failed. Related tests failed on modified code."
  exit 1
}

echo "✅ [PRE-COMMIT] All 11 verifiers and smart test guard passed successfully."
exit 0
